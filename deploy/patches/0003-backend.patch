--- a/internal/ai/agent.go
+++ b/internal/ai/agent.go
@@ -0,0 +1,119 @@
+package ai
+
+import (
+	"context"
+	"time"
+
+	"golem_century/internal/game"
+)
+
+// IntentKind classifies what an AI move did to a human, for the "AI intent" toasts.
+type IntentKind string
+
+const (
+	IntentTookTargetGolem IntentKind = "took_target_golem" // claimed the golem the target was going for
+	IntentBlockCoin       IntentKind = "block_coin"        // took a coin slot the target was racing for
+	IntentTookWantedCard  IntentKind = "took_wanted_card"  // acquired a merchant card the target needed
+	IntentSacrifice       IntentKind = "sacrifice"         // gave up own value to hinder the target (coalition)
+	IntentRushing         IntentKind = "rushing"           // is one golem away from triggering the end
+)
+
+// Intent is one explainable consequence of an AI move for a specific opponent.
+type Intent struct {
+	Kind     IntentKind
+	TargetID int  // player ID of the opponent concerned (0 = everyone)
+	CardID   int  // card involved, if any
+	Motive   bool // true when denial actually changed the choice (wording: "blocking" vs "grabbed first")
+}
+
+// SearchStats reports how a decision was made (logged; also used by the benchmark tool).
+type SearchStats struct {
+	Iterations int
+	Nodes      int
+	Workers    int
+	Elapsed    time.Duration
+	Fallback   string // non-empty when the agent fell back to a simpler policy
+}
+
+// Decision is an agent's answer for the current player of a snapshot.
+type Decision struct {
+	Action game.Action
+	// Discard is the agent's choice for the excess crystals when Action overflows the caravan
+	// (nil: the caller discards the cheapest crystals).
+	Discard *game.Resources
+	Intents []Intent
+	Stats   SearchStats
+}
+
+// DecideOptions carries per-decision context the snapshot does not hold.
+type DecideOptions struct {
+	// Teams[i] is the team of seat i (players with the same team share a coalition reward).
+	// nil means everybody is on their own team.
+	Teams []int
+	// Seed drives every random choice of this decision (reproducible tests and tournaments).
+	Seed uint64
+	// Iterations > 0 replaces the time budget by a fixed iteration count (deterministic tests).
+	Iterations int
+}
+
+// Agent chooses moves for one seat. Implementations may keep state between decisions (e.g. the
+// opponent model), so the session keeps one agent per AI seat. Decide must not modify snap, must
+// return promptly when ctx is cancelled, and must only use public information: the real deck
+// order inside snap is never looked at.
+type Agent interface {
+	Decide(ctx context.Context, snap *game.GameState, o DecideOptions) (Decision, error)
+	Level() Level
+	Profile() Profile
+}
+
+// NewAgent returns the agent for a level (Easy: 1-ply policy; others: MCTS ensemble).
+func NewAgent(l Level, rt *Runtime) Agent {
+	if rt == nil {
+		rt = DefaultRuntime()
+	}
+	return newSearchAgent(rt.Profile(l), rt)
+}
+
+// NewAgentWithProfile returns an agent with an explicit profile (tests, tuning, benchmarks).
+func NewAgentWithProfile(p Profile, rt *Runtime) Agent {
+	if rt == nil {
+		rt = DefaultRuntime()
+	}
+	return newSearchAgent(p, rt)
+}
+
+// NewLegacyGreedy returns the simple engine-based greedy policy (a tournament baseline).
+func NewLegacyGreedy() Agent { return newGreedyAgent(DefaultProfile(Easy), DefaultRuntime()) }
+
+// strategyAgent adapts a legacy game.AIStrategy (BasicAI, RestOnlyAI) to the Agent interface.
+type strategyAgent struct {
+	s     game.AIStrategy
+	level Level
+}
+
+// FromStrategy wraps a legacy strategy; it reports the given level for display purposes.
+func FromStrategy(s game.AIStrategy, l Level) Agent { return &strategyAgent{s: s, level: l} }
+
+func (a *strategyAgent) Level() Level     { return a.level }
+func (a *strategyAgent) Profile() Profile { return Profile{Level: a.level} }
+
+func (a *strategyAgent) Decide(_ context.Context, snap *game.GameState, _ DecideOptions) (Decision, error) {
+	p := snap.GetCurrentPlayer()
+	return Decision{Action: a.s.ChooseAction(p, snap.Market, snap)}, nil
+}
+
+// asStrategy adapts an Agent to the legacy game.AIStrategy interface (CLI simulator).
+type asStrategy struct{ a Agent }
+
+// AsStrategy exposes an Agent as a game.AIStrategy.
+func AsStrategy(a Agent) game.AIStrategy { return asStrategy{a} }
+
+func (s asStrategy) GetName() string { return "ai-" + s.a.Level().String() }
+
+func (s asStrategy) ChooseAction(_ *game.Player, _ *game.Market, gs *game.GameState) game.Action {
+	d, err := s.a.Decide(context.Background(), gs.Clone(), DecideOptions{})
+	if err != nil {
+		return game.Action{Type: game.Rest}
+	}
+	return d.Action
+}
--- a/internal/ai/agent_test.go
+++ b/internal/ai/agent_test.go
@@ -0,0 +1,113 @@
+package ai
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golem_century/internal/game"
+)
+
+func TestParseLevel(t *testing.T) {
+	for in, want := range map[string]Level{
+		"easy": Easy, "Medium": Medium, "HARD": Hard, "veryhard": VeryHard,
+		"very_hard": VeryHard, "very-hard": VeryHard, " very hard ": VeryHard,
+	} {
+		got, err := ParseLevel(in)
+		if err != nil || got != want {
+			t.Errorf("ParseLevel(%q) = %v, %v; want %v", in, got, err, want)
+		}
+		if back, _ := ParseLevel(got.String()); back != got {
+			t.Errorf("String() round trip failed for %v", got)
+		}
+	}
+	if _, err := ParseLevel("impossible"); err == nil {
+		t.Error("unknown level must be rejected")
+	}
+}
+
+func TestScheduler_NeverExceedsCapacity(t *testing.T) {
+	s := NewScheduler(3)
+	var inUse, peak atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			got, release := s.Acquire(context.Background(), 1+i%4)
+			defer release()
+			if got < 1 {
+				t.Error("Acquire with a live context must grant at least one token")
+				return
+			}
+			n := inUse.Add(int32(got))
+			for {
+				p := peak.Load()
+				if n <= p || peak.CompareAndSwap(p, n) {
+					break
+				}
+			}
+			time.Sleep(time.Millisecond)
+			inUse.Add(-int32(got))
+		}(i)
+	}
+	wg.Wait()
+	if peak.Load() > 3 {
+		t.Fatalf("peak tokens in use %d > capacity 3", peak.Load())
+	}
+}
+
+func TestScheduler_AcquireRespectsContext(t *testing.T) {
+	s := NewScheduler(1)
+	_, release := s.Acquire(context.Background(), 1)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if got, rel := s.Acquire(ctx, 1); got != 0 {
+		rel()
+		t.Fatal("Acquire must give up when the context ends while the pool is empty")
+	}
+	release()
+}
+
+// playGame runs agents on the reference engine through Step and returns the finished state.
+// Every decision must be legal: an illegal action fails the test.
+func playGame(t *testing.T, gs *game.GameState, agents []Agent, maxSteps int) *game.GameState {
+	t.Helper()
+	for step := 0; step < maxSteps && !gs.GameOver; step++ {
+		seat := gs.CurrentTurn % len(gs.Players)
+		d, err := agents[seat].Decide(context.Background(), gs.Clone(), DecideOptions{Seed: uint64(step)})
+		if err != nil {
+			t.Fatalf("step %d: decide: %v", step, err)
+		}
+		res, err := gs.Step(d.Action)
+		if err != nil {
+			t.Fatalf("step %d: seat %d chose an illegal action %+v: %v", step, seat, d.Action, err)
+		}
+		if res.PendingDiscard > 0 {
+			disc := d.Discard
+			if disc == nil {
+				disc = game.AutoDiscard(gs.Players[seat].Resources, res.PendingDiscard)
+			}
+			if _, err := gs.Step(game.Action{Type: game.Discard, DiscardResources: disc}); err != nil {
+				t.Fatalf("step %d: discard %v rejected: %v", step, disc, err)
+			}
+		}
+	}
+	return gs
+}
+
+func TestGreedyAgent_PlaysLegalCompleteGames(t *testing.T) {
+	for n := 2; n <= 5; n++ {
+		gs := game.NewGameState(n, int64(100+n))
+		agents := make([]Agent, n)
+		for i := range agents {
+			agents[i] = newGreedyAgent(DefaultProfile(Easy), DefaultRuntime())
+		}
+		playGame(t, gs, agents, 2000)
+		if !gs.GameOver {
+			t.Fatalf("%d players: greedy game did not finish within 2000 steps (round %d)", n, gs.Round)
+		}
+	}
+}
--- a/internal/ai/arena/aibench/main.go
+++ b/internal/ai/arena/aibench/main.go
@@ -0,0 +1,250 @@
+// Command aibench benchmarks and calibrates the Century Golem AI (docs/ai/tinh-chinh.md).
+//
+//	aibench bench      -level veryhard -n 30            # think time / iterations on THIS machine
+//	aibench tournament -a hard -b medium -players 2 -seeds 200 -iters-a 40000 -iters-b 6000
+//	aibench ladder     -seeds 100                       # every adjacent pair + baselines
+//	aibench coalition  -seeds 50 -players 4             # proxy human vs 3 Very Hard / 3 Hard
+//
+// It lives under internal/ so it ships in the backend patch, but it is never built into the
+// production image.
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"math/rand"
+	"os"
+	"runtime"
+	"sort"
+	"time"
+
+	"golem_century/internal/ai"
+	"golem_century/internal/ai/arena"
+	"golem_century/internal/game"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		fmt.Fprintln(os.Stderr, "usage: aibench bench|tournament|ladder|coalition [flags]")
+		os.Exit(2)
+	}
+	switch os.Args[1] {
+	case "bench":
+		bench(os.Args[2:])
+	case "tournament":
+		tournament(os.Args[2:])
+	case "ladder":
+		ladder(os.Args[2:])
+	case "coalition":
+		coalition(os.Args[2:])
+	case "variant":
+		variant(os.Args[2:])
+	default:
+		fmt.Fprintln(os.Stderr, "unknown command", os.Args[1])
+		os.Exit(2)
+	}
+}
+
+func level(s string) ai.Level {
+	l, err := ai.ParseLevel(s)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	return l
+}
+
+func botFor(name string, iters, workers int) arena.Bot {
+	switch name {
+	case "random":
+		return arena.RandomBot
+	case "greedy":
+		return arena.GreedyBot
+	case "legacy":
+		return arena.LegacyBot
+	case "rusher":
+		return arena.RusherBot
+	case "coinchaser":
+		return arena.CoinChaserBot
+	}
+	return arena.LevelBot(level(name), iters, workers)
+}
+
+// bench measures real decisions with the level's time budget on mid-game positions.
+func bench(args []string) {
+	fs := flag.NewFlagSet("bench", flag.ExitOnError)
+	lv := fs.String("level", "veryhard", "level")
+	n := fs.Int("n", 30, "decisions")
+	players := fs.Int("players", 4, "players")
+	threads := fs.Int("threads", 0, "AI_MAX_THREADS (0 = auto)")
+	scale := fs.Int("scale", 100, "AI_THINK_SCALE_PCT")
+	fs.Parse(args)
+
+	rt := &ai.Runtime{Sched: ai.NewScheduler(*threads), ScalePct: *scale}
+	agent := ai.NewAgent(level(*lv), rt)
+	var elapsed []time.Duration
+	iters, nodes := 0, 0
+	var ms runtime.MemStats
+	peak := uint64(0)
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < *n; i++ {
+		gs := game.NewGameState(*players, int64(1000+i))
+		for k := 0; k < 8+rng.Intn(30) && !gs.GameOver; k++ { // random mid-game position
+			acts := gs.LegalActions()
+			gs.Step(acts[rng.Intn(len(acts))])
+			if p := gs.GetCurrentPlayer(); p.PendingDiscard > 0 {
+				gs.Step(game.Action{Type: game.Discard, DiscardResources: game.AutoDiscard(p.Resources, p.PendingDiscard)})
+			}
+		}
+		if gs.GameOver {
+			continue
+		}
+		start := time.Now()
+		d, err := agent.Decide(context.Background(), gs.Clone(), ai.DecideOptions{Seed: uint64(i)})
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		elapsed = append(elapsed, time.Since(start))
+		iters += d.Stats.Iterations
+		nodes += d.Stats.Nodes
+		runtime.ReadMemStats(&ms)
+		peak = max(peak, ms.HeapInuse)
+	}
+	sort.Slice(elapsed, func(i, j int) bool { return elapsed[i] < elapsed[j] })
+	k := len(elapsed)
+	if k == 0 {
+		fmt.Println("no decisions")
+		return
+	}
+	total := time.Duration(0)
+	for _, e := range elapsed {
+		total += e
+	}
+	fmt.Printf("level=%s players=%d decisions=%d cpus=%d threads=%d\n", *lv, *players, k, runtime.NumCPU(), rt.Sched.Capacity())
+	fmt.Printf("think p50=%v p95=%v max=%v\n", elapsed[k/2], elapsed[k*95/100], elapsed[k-1])
+	fmt.Printf("iterations/decision=%d  iterations/s=%.0f  nodes/decision=%d  heap-in-use peak=%.1f MiB\n",
+		iters/k, float64(iters)/total.Seconds(), nodes/k, float64(peak)/(1<<20))
+}
+
+func tournament(args []string) {
+	fs := flag.NewFlagSet("tournament", flag.ExitOnError)
+	a := fs.String("a", "hard", "bot A")
+	b := fs.String("b", "medium", "bot B")
+	players := fs.Int("players", 2, "players")
+	seeds := fs.Int("seeds", 100, "seeds (each played once per seat)")
+	itersA := fs.Int("iters-a", 20000, "iterations per decision for A")
+	itersB := fs.Int("iters-b", 5000, "iterations per decision for B")
+	parallel := fs.Int("parallel", 0, "parallel games (0 = all CPUs)")
+	first := fs.Int64("seed", 1, "first seed")
+	fs.Parse(args)
+	s := arena.HeadToHead(botFor(*a, *itersA, 1), botFor(*b, *itersB, 1), *players, *seeds, *first, *parallel)
+	fmt.Println(s)
+	for i, e := range s.Errors {
+		if i < 5 {
+			fmt.Println("  error:", e)
+		}
+	}
+}
+
+// ladderIters are the per-decision iteration budgets that approximate each level on the phone
+// (see docs/ai/hieu-nang.md; measured with `aibench bench` on pixel3xl).
+var ladderIters = map[ai.Level]int{ai.Easy: 0, ai.Medium: 5000, ai.Hard: 40000, ai.VeryHard: 200000}
+
+func ladder(args []string) {
+	fs := flag.NewFlagSet("ladder", flag.ExitOnError)
+	seeds := fs.Int("seeds", 100, "seeds per pairing")
+	players := fs.Int("players", 2, "players")
+	parallel := fs.Int("parallel", 0, "parallel games")
+	scale := fs.Float64("iter-scale", 1, "multiply every iteration budget")
+	fs.Parse(args)
+	it := func(l ai.Level) int { return int(float64(ladderIters[l]) * *scale) }
+	pairs := [][2]arena.Bot{
+		{arena.LevelBot(ai.Easy, 0, 0), arena.LegacyBot},
+		{arena.LevelBot(ai.Easy, 0, 0), arena.GreedyBot},
+		{arena.LevelBot(ai.Medium, it(ai.Medium), 0), arena.LegacyBot},
+		{arena.LevelBot(ai.Medium, it(ai.Medium), 0), arena.LevelBot(ai.Easy, 0, 0)},
+		{arena.LevelBot(ai.Hard, it(ai.Hard), 0), arena.LevelBot(ai.Medium, it(ai.Medium), 0)},
+		{arena.LevelBot(ai.VeryHard, it(ai.VeryHard), 0), arena.LevelBot(ai.Hard, it(ai.Hard), 0)},
+		{arena.LevelBot(ai.Hard, it(ai.Hard), 0), arena.RusherBot},
+		{arena.LevelBot(ai.Hard, it(ai.Hard), 0), arena.CoinChaserBot},
+	}
+	for _, p := range pairs {
+		start := time.Now()
+		s := arena.HeadToHead(p[0], p[1], *players, *seeds, 1, *parallel)
+		fmt.Printf("%s  (%s)\n", s, time.Since(start).Round(time.Second))
+		for i, e := range s.Errors {
+			if i < 3 {
+				fmt.Println("  error:", e)
+			}
+		}
+	}
+}
+
+func coalition(args []string) {
+	fs := flag.NewFlagSet("coalition", flag.ExitOnError)
+	seeds := fs.Int("seeds", 50, "seeds (human plays every seat)")
+	players := fs.Int("players", 4, "players")
+	parallel := fs.Int("parallel", 0, "parallel games")
+	humanIters := fs.Int("human-iters", 2*ladderIters[ai.VeryHard], "proxy human iterations")
+	oppScale := fs.Float64("iter-scale", 1, "multiply the AI opponents' iteration budgets")
+	fs.Parse(args)
+	human := arena.ProfileBot("proxy-human", ai.DefaultProfile(ai.Hard), *humanIters)
+	for _, opp := range []arena.Bot{
+		arena.LevelBot(ai.Hard, int(float64(ladderIters[ai.Hard])**oppScale), 0),
+		arena.LevelBot(ai.VeryHard, int(float64(ladderIters[ai.VeryHard])**oppScale), 0),
+	} {
+		start := time.Now()
+		r := arena.Coalition(human, opp, *players, *seeds, 1, *parallel)
+		fmt.Printf("proxy human vs %d×%-9s: %4d games, human wins %5.1f%% [%4.1f–%4.1f] (fair share %.0f%%)  errors %d  (%s)\n",
+			*players-1, r.Opponents, r.Games, 100*r.WinRate, 100*r.Lo, 100*r.Hi, 100/float64(*players), len(r.Errors), time.Since(start).Round(time.Second))
+	}
+}
+
+// variant pits a level with modified evaluator weights against the same level with the defaults.
+func variant(args []string) {
+	fs := flag.NewFlagSet("variant", flag.ExitOnError)
+	lv := fs.String("level", "medium", "level")
+	iters := fs.Int("iters", 5000, "iterations per decision (both sides)")
+	workers := fs.Int("workers", 1, "workers per search")
+	players := fs.Int("players", 2, "players")
+	seeds := fs.Int("seeds", 100, "seeds")
+	parallel := fs.Int("parallel", 0, "parallel games")
+	w := ai.DefaultWeights
+	fs.Float64Var(&w.CrystalLevel, "crystal", w.CrystalLevel, "CrystalLevel")
+	fs.Float64Var(&w.Progress1, "p1", w.Progress1, "Progress1")
+	fs.Float64Var(&w.Progress2, "p2", w.Progress2, "Progress2")
+	fs.Float64Var(&w.Gamma, "gamma", w.Gamma, "Gamma")
+	fs.Float64Var(&w.Contested, "contested", w.Contested, "Contested")
+	fs.Float64Var(&w.Engine, "engine", w.Engine, "Engine")
+	fs.Float64Var(&w.Played, "played", w.Played, "Played")
+	fs.Float64Var(&w.ExtraCard, "extracard", w.ExtraCard, "ExtraCard")
+	cpuct := fs.Float64("cpuct", 0, "override CPuct (0 = default)")
+	eps := fs.Float64("eps", -1, "override Epsilon (-1 = default)")
+	rollout := fs.Int("rollout", -1, "override RolloutTurns (-1 = default)")
+	fs.Parse(args)
+	l := level(*lv)
+	pv := ai.DefaultProfile(l)
+	pv.Workers = *workers
+	pv.Weights = &w
+	if *cpuct > 0 {
+		pv.CPuct = *cpuct
+	}
+	if *eps >= 0 {
+		pv.Epsilon = *eps
+	}
+	if *rollout >= 0 {
+		pv.RolloutTurns = *rollout
+	}
+	base := ai.DefaultProfile(l)
+	base.Workers = *workers
+	s := arena.HeadToHead(arena.ProfileBot("variant", pv, *iters), arena.ProfileBot("default", base, *iters), *players, *seeds, 1, *parallel)
+	fmt.Printf("%+v\n", w)
+	for i, e := range s.Errors {
+		if i < 5 {
+			fmt.Println("  error:", e)
+		}
+	}
+	fmt.Println(s)
+}
--- a/internal/ai/arena/bots.go
+++ b/internal/ai/arena/bots.go
@@ -0,0 +1,147 @@
+// Package arena runs AI-vs-AI games for calibration and benchmarks (docs/ai/tinh-chinh.md).
+// Every game is played on the reference engine through game.Step, so an illegal AI move fails
+// the run instead of being silently fixed.
+package arena
+
+import (
+	"context"
+	"math"
+	"math/rand/v2"
+
+	"golem_century/internal/ai"
+	"golem_century/internal/ai/sim"
+	"golem_century/internal/game"
+)
+
+// Bot creates a fresh agent per game (agents may keep per-game state).
+type Bot struct {
+	Name       string
+	New        func() ai.Agent
+	Iterations int // fixed iteration budget per decision (0 = the agent's own time budget)
+}
+
+// LevelBot is a difficulty level with a fixed iteration budget (deterministic, machine-independent).
+func LevelBot(l ai.Level, iterations int, workers int) Bot {
+	return Bot{
+		Name: l.String(),
+		New: func() ai.Agent {
+			p := ai.DefaultProfile(l)
+			if workers > 0 {
+				p.Workers = workers
+			}
+			return ai.NewAgentWithProfile(p, ai.DefaultRuntime())
+		},
+		Iterations: iterations,
+	}
+}
+
+// ProfileBot is a bot with an explicit profile (tuning experiments).
+func ProfileBot(name string, p ai.Profile, iterations int) Bot {
+	return Bot{Name: name, New: func() ai.Agent { return ai.NewAgentWithProfile(p, ai.DefaultRuntime()) }, Iterations: iterations}
+}
+
+// Baselines.
+var (
+	RandomBot = Bot{Name: "random", New: func() ai.Agent { return &scripted{pick: pickRandom} }}
+	GreedyBot = Bot{Name: "greedy", New: func() ai.Agent { return ai.NewLegacyGreedy() }}
+	LegacyBot = Bot{Name: "legacy", New: func() ai.Agent {
+		return ai.FromStrategy(game.NewAIPlayer(nil), ai.LevelUnknown)
+	}}
+	RusherBot     = Bot{Name: "rusher", New: func() ai.Agent { return &scripted{pick: pickRusher} }}
+	CoinChaserBot = Bot{Name: "coinchaser", New: func() ai.Agent { return &scripted{pick: pickCoinChaser} }}
+)
+
+// scripted is a rule-based baseline bot working on the sim state.
+type scripted struct {
+	pick func(s *sim.State, acts []sim.Action, rng *rand.Rand) sim.Action
+}
+
+func (b *scripted) Level() ai.Level     { return ai.LevelUnknown }
+func (b *scripted) Profile() ai.Profile { return ai.Profile{} }
+
+func (b *scripted) Decide(_ context.Context, snap *game.GameState, o ai.DecideOptions) (ai.Decision, error) {
+	st, err := sim.FromGame(snap)
+	if err != nil {
+		return ai.Decision{}, err
+	}
+	rng := rand.New(rand.NewPCG(o.Seed, 77))
+	acts := st.AppendLegal(nil, sim.Search)
+	a := b.pick(&st, acts, rng)
+	ga, err := sim.ToGameAction(snap, a)
+	return ai.Decision{Action: ga}, err
+}
+
+func pickRandom(_ *sim.State, acts []sim.Action, rng *rand.Rand) sim.Action {
+	return acts[rng.IntN(len(acts))]
+}
+
+// deficitCost is the crystal-level cost still missing for a golem (same idea as the evaluator).
+func deficitCost(res, req sim.Crystals) int {
+	cost := 0
+	for c := 0; c < 4; c++ {
+		if d := int(req[c]) - int(res[c]); d > 0 {
+			cost += d * (c + 1)
+		}
+	}
+	return cost
+}
+
+// greedyTowards picks the move that most reduces the deficit to the golem chosen by target.
+func greedyTowards(s *sim.State, acts []sim.Action, rng *rand.Rand, target func(*sim.State) int) sim.Action {
+	best, bestV := acts[0], math.Inf(-1)
+	for _, a := range acts {
+		c := *s
+		c.Apply(a, sim.RandDrawer{R: rng})
+		seat := s.Seat()
+		v := -float64(deficitCost(c.P[seat].Res, sim.Golems[c.Row[target(&c)]].Req))
+		if a.Kind == sim.ARest && s.Cur().Played == 0 {
+			v -= 100
+		}
+		if a.Kind == sim.AAcquire {
+			v -= 0.5 // rushers rarely draft
+		}
+		if v > bestV {
+			best, bestV = a, v
+		}
+	}
+	return best
+}
+
+// pickRusher claims the cheapest golem as soon as possible.
+func pickRusher(s *sim.State, acts []sim.Action, rng *rand.Rand) sim.Action {
+	bestClaim, bestReq := -1, 1<<30
+	for i, a := range acts {
+		if a.Kind == sim.AClaim {
+			if r := sim.Golems[s.Row[a.Card]].Req.Total(); r < bestReq {
+				bestClaim, bestReq = i, r
+			}
+		}
+	}
+	if bestClaim >= 0 {
+		return acts[bestClaim]
+	}
+	return greedyTowards(s, acts, rng, func(c *sim.State) int {
+		best, bestCost := 0, 1<<30
+		for j := 0; j < int(c.NRow); j++ {
+			if cost := deficitCost(c.Cur().Res, sim.Golems[c.Row[j]].Req); cost < bestCost {
+				best, bestCost = j, cost
+			}
+		}
+		return best
+	})
+}
+
+// pickCoinChaser goes for the golems that pay coins (row positions 0 and 1).
+func pickCoinChaser(s *sim.State, acts []sim.Action, rng *rand.Rand) sim.Action {
+	for _, a := range acts {
+		if a.Kind == sim.AClaim && a.Card <= 1 {
+			return a
+		}
+	}
+	for _, a := range acts {
+		if a.Kind == sim.AClaim {
+			return a
+		}
+	}
+	return greedyTowards(s, acts, rng, func(c *sim.State) int { return 0 })
+}
