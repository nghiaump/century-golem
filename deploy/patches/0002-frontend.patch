+/* Design tokens — "Stone & Crystal" (Đá & Pha lê). Nguồn sự thật duy nhất cho màu/bo góc/bóng/chuyển động.
+   Màu lưu dạng kênh RGB ("r g b") để Tailwind dùng được độ mờ: bg-rock-800/80 (map trong tailwind.config.js).
+   Bảng màu hài hoà với art của bộ bài: đá tối, gỗ ấm, giấy da, lưng bài tím, điểm nhấn xanh mòng két. */
+:root {
+  /* Đá (panel, nền) */
+  --rock-950: 18 19 28;     /* #12131c */
+  --rock-900: 27 29 42;     /* #1b1d2a */
+  --rock-800: 42 47 69;     /* #2a2f45 */
+  --rock-700: 54 60 87;     /* #363c57 */
+  --rock-600: 74 81 112;    /* #4a5170 */
+  --rock-400: 138 143 168;  /* #8a8fa8 */
+  --rock-200: 201 203 216;  /* #c9cbd8 */
+
+  /* Đồng (viền, nút chính, điểm nhấn) — bronze-500 chỉ cho viền/chữ lớn; chữ nhỏ dùng bronze-300 */
