+++ b/internal/ai/sim/state.go
@@ -0,0 +1,150 @@
+package sim
+
+import (
+	"fmt"
+	"sort"
+
+	"golem_century/internal/game"
+)
+
+// Player is one seat.
+type Player struct {
+	Res      Crystals
+	Hand     uint64 // bit m = merchant index m in hand
+	Played   uint64 // bit m = merchant index m played (back to hand on rest)
+	Golems   uint8
+	GolemPts int16
+	CoinPts  int16
+	Pending  int8 // crystals to discard before the turn can end
+}
+
+// FinalPoints is golem points + coins + 1 per non-yellow crystal.
+func (p *Player) FinalPoints() int {
+	return int(p.GolemPts) + int(p.CoinPts) + int(p.Res[1]) + int(p.Res[2]) + int(p.Res[3])
+}
+
+// Banked is golem points + coins.
+func (p *Player) Banked() int { return int(p.GolemPts) + int(p.CoinPts) }
+
+// State is a full game position. Copy it by value.
+type State struct {
+	P         [MaxPlayers]Player
+	N         uint8
+	Turn      int16 // the engine's CurrentTurn (seat = Turn % N)
+	Round     int16
+	LastRound bool
+	Over      bool
+	Winner    int8 // seat, -1 while running
+	Goal      uint8
+
+	Market  [MarketSize]uint8 // merchant indices, positions 0..NMarket-1
+	MDep    [MarketSize]Crystals
+	NMarket uint8
+	Row     [GolemRowSize]uint8 // golem indices, positions 0..NRow-1
+	NRow    uint8
+
+	MPool  [NumDeckMerchants]uint8 // unseen merchant cards (unordered)
+	NMPool uint8
+	GPool  [NumGolems]uint8 // unseen golems (unordered)
+	NGPool uint8
+
+	Copper, Silver int8
+}
+
+// Seat returns the seat to move.
+func (s *State) Seat() int { return int(s.Turn) % int(s.N) }
+
+// Cur returns the player to move.
+func (s *State) Cur() *Player { return &s.P[s.Seat()] }
+
+// FromGame converts an engine state. The unseen pools are sorted by card ID, so the real deck
+// order is erased.
+func FromGame(gs *game.GameState) (State, error) {
+	var s State
+	n := len(gs.Players)
+	if n < 1 || n > MaxPlayers {
+		return s, fmt.Errorf("sim: unsupported player count %d", n)
+	}
+	s.N = uint8(n)
+	s.Turn = int16(gs.CurrentTurn)
+	s.Round = int16(gs.Round)
+	s.LastRound = gs.LastRound
+	s.Over = gs.GameOver
+	s.Goal = uint8(gs.GolemsToEnd())
+	s.Winner = -1
+	for i, p := range gs.Players {
+		sp := &s.P[i]
+		sp.Res = crystalsOf(p.Resources)
+		for _, c := range p.Hand {
+			m, ok := MerchantIndex(c)
+			if !ok {
+				return s, fmt.Errorf("sim: unknown merchant card %q", c.Name)
+			}
+			sp.Hand |= 1 << m
+		}
+		for _, c := range p.PlayedCards {
+			m, ok := MerchantIndex(c)
+			if !ok {
+				return s, fmt.Errorf("sim: unknown merchant card %q", c.Name)
+			}
+			sp.Played |= 1 << m
+		}
+		sp.Golems = uint8(len(p.PointCards))
+		for _, c := range p.PointCards {
+			sp.GolemPts += int16(c.Points)
+		}
+		for _, c := range p.Coins {
+			sp.CoinPts += int16(c.Points)
+		}
+		sp.Pending = int8(p.PendingDiscard)
+		if gs.Winner == p {
+			s.Winner = int8(i)
+		}
+	}
+	m := gs.Market
+	for i, c := range m.ActionCards {
+		idx, ok := MerchantIndex(c)
+		if !ok {
+			return s, fmt.Errorf("sim: unknown market card %q", c.Name)
+		}
+		s.Market[i] = idx
+		s.MDep[i] = crystalsOf(c.Deposits)
+	}
+	s.NMarket = uint8(len(m.ActionCards))
+	for i, c := range m.PointCards {
+		idx, ok := GolemIndex(c)
+		if !ok {
+			return s, fmt.Errorf("sim: unknown golem %q", c.Name)
+		}
+		s.Row[i] = idx
+	}
+	s.NRow = uint8(len(m.PointCards))
+	for _, c := range m.ActionDeck {
+		idx, _ := MerchantIndex(c)
+		s.MPool[s.NMPool] = idx
+		s.NMPool++
+	}
+	for _, c := range m.PointDeck {
+		idx, _ := GolemIndex(c)
+		s.GPool[s.NGPool] = idx
+		s.NGPool++
+	}
+	sortU8(s.MPool[:s.NMPool])
+	sortU8(s.GPool[:s.NGPool])
+	if len(m.Coins) > 0 {
+		s.Copper = int8(m.Coins[0].Amount)
+	}
+	if len(m.Coins) > 1 {
+		s.Silver = int8(m.Coins[1].Amount)
+	}
+	return s, nil
+}
+
+// Canonical returns a copy with both pools sorted (for comparisons).
+func (s State) Canonical() State {
+	sortU8(s.MPool[:s.NMPool])
+	sortU8(s.GPool[:s.NGPool])
+	return s
+}
+
+func sortU8(a []uint8) { sort.Slice(a, func(i, j int) bool { return a[i] < a[j] }) }
--- a/internal/ai/sim/step.go
+++ b/internal/ai/sim/step.go
@@ -0,0 +1,146 @@
+package sim
+
+import "math/rand/v2"
+
+// Drawer decides which unseen card fills an emptied slot: it returns a position in the unseen
+// pool of size n > 0 (State.MPool / State.GPool). Search uses RandDrawer; the differential test
+// replays the real deck. Only the size is passed so the state never escapes to the heap.
+type Drawer interface {
+	Merchant(n int) int
+	Golem(n int) int
+}
+
+// RandDrawer draws uniformly at random.
+type RandDrawer struct{ R *rand.Rand }
+
+func (d RandDrawer) Merchant(n int) int { return d.R.IntN(n) }
+func (d RandDrawer) Golem(n int) int    { return d.R.IntN(n) }
+
+// Apply plays a legal move for the player to move (the caller guarantees legality, e.g. by taking
+// it from AppendLegal). It mirrors game.GameState.Step: after the move either a discard is
+// pending (same player again) or the turn ends — finishing the game when the last seat completes
+// the last round.
+func (s *State) Apply(a Action, d Drawer) {
+	seat := s.Seat()
+	p := &s.P[seat]
+	switch a.Kind {
+	case APlay:
+		def := &Merchants[a.Card]
+		switch def.Kind {
+		case KProduce:
+			addInto(&p.Res, def.Out, 1)
+		case KUpgrade:
+			p.Res = a.Vec
+		case KTrade:
+			m := int8(a.Mult)
+			addInto(&p.Res, def.In, -m)
+			addInto(&p.Res, def.Out, m)
+		}
+		bit := uint64(1) << a.Card
+		p.Hand &^= bit
+		p.Played |= bit
+
+	case AAcquire:
+		k := int(a.Card)
+		// place the crystals, cheapest colour on the leftmost card
+		pos := 0
+		for c := 0; c < 4; c++ {
+			for n := a.Vec[c]; n > 0; n-- {
+				s.MDep[pos][c]++
+				pos++
+			}
+		}
+		addInto(&p.Res, a.Vec, -1)
+		addInto(&p.Res, s.MDep[k], 1)
+		p.Hand |= uint64(1) << s.Market[k]
+		for i := k; i+1 < int(s.NMarket); i++ {
+			s.Market[i] = s.Market[i+1]
+			s.MDep[i] = s.MDep[i+1]
+		}
+		s.NMarket--
+		s.Market[s.NMarket] = 0
+		s.MDep[s.NMarket] = Crystals{}
+		if s.NMPool > 0 {
+			i := d.Merchant(int(s.NMPool))
+			s.Market[s.NMarket] = s.MPool[i]
+			s.NMPool--
+			s.MPool[i] = s.MPool[s.NMPool]
+			s.MPool[s.NMPool] = 0
+			s.NMarket++
+		}
+
+	case AClaim:
+		j := int(a.Card)
+		g := &Golems[s.Row[j]]
+		addInto(&p.Res, g.Req, -1)
+		p.GolemPts += int16(g.Points)
+		p.Golems++
+		for i := j; i+1 < int(s.NRow); i++ {
+			s.Row[i] = s.Row[i+1]
+		}
+		s.NRow--
+		s.Row[s.NRow] = 0
+		if s.NGPool > 0 {
+			i := d.Golem(int(s.NGPool))
+			s.Row[s.NRow] = s.GPool[i]
+			s.NGPool--
+			s.GPool[i] = s.GPool[s.NGPool]
+			s.GPool[s.NGPool] = 0
+			s.NRow++
+		}
+		switch {
+		case j == 0 && s.Copper > 0:
+			s.Copper--
+			p.CoinPts += 3
+		case j == 0 && s.Silver > 0:
+			s.Silver--
+			p.CoinPts++
+		case j == 1 && s.Copper > 0 && s.Silver > 0:
+			s.Silver--
+			p.CoinPts++
+		}
+		if p.Golems >= s.Goal {
+			s.LastRound = true
+		}
+
+	case ARest:
+		p.Hand |= p.Played
+		p.Played = 0
+
+	case ADiscard:
+		addInto(&p.Res, a.Vec, -1)
+		p.Pending = 0
+	}
+
+	if t := p.Res.Total(); t > MaxCrystals {
+		p.Pending = int8(t - MaxCrystals)
+		return
+	}
+	if s.LastRound && seat == int(s.N)-1 {
+		s.finish()
+		return
+	}
+	s.Turn++
+	if s.Turn%int16(s.N) == 0 {
+		s.Round++
+	}
+}
+
+// finish ends the game: highest final points, ties to the later seat.
+func (s *State) finish() {
+	s.Over = true
+	best := -1
+	for i := 0; i < int(s.N); i++ {
+		if pts := s.P[i].FinalPoints(); pts >= best {
+			best = pts
+			s.Winner = int8(i)
+		}
+	}
+}
+
+func addInto(dst *Crystals, v Crystals, m int8) {
+	dst[0] += v[0] * m
+	dst[1] += v[1] * m
+	dst[2] += v[2] * m
+	dst[3] += v[3] * m
+}
