+// Package ai implements the computer opponents for Century: Golem Edition.
+//
+// All levels share one engine (evaluation, opponent model, search); a Profile decides how much
+// of it a level uses: search budget and workers, root-choice noise, opponent modelling and the
+// utility it maximises. See docs/ai/README.md (overview) and docs/ai/thiet-ke.md (design).
+package ai
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// Level is an AI difficulty level.
+type Level uint8
+
+const (
+	LevelUnknown Level = iota
+	Easy
+	Medium
+	Hard
+	VeryHard
+)
+
+// AllLevels lists the selectable levels, weakest first.
+var AllLevels = []Level{Easy, Medium, Hard, VeryHard}
+
+// String returns the wire name ("easy", "medium", "hard", "veryhard").
+func (l Level) String() string {
+	switch l {
+	case Easy:
+		return "easy"
+	case Medium:
+		return "medium"
+	case Hard:
+		return "hard"
+	case VeryHard:
+		return "veryhard"
+	}
+	return "unknown"
+}
+
+// Label returns the display name ("Easy", …, "Very Hard").
+func (l Level) Label() string {
+	switch l {
+	case Easy:
+		return "Easy"
+	case Medium:
+		return "Medium"
+	case Hard:
+		return "Hard"
+	case VeryHard:
+		return "Very Hard"
+	}
+	return "Unknown"
+}
+
+// ParseLevel accepts the wire names case-insensitively, plus "very_hard"/"very-hard"/"very hard".
+func ParseLevel(s string) (Level, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "easy":
+		return Easy, nil
+	case "medium", "normal":
+		return Medium, nil
+	case "hard":
+		return Hard, nil
+	case "veryhard", "very_hard", "very-hard", "very hard":
+		return VeryHard, nil
+	}
+	return LevelUnknown, fmt.Errorf("unknown difficulty %q (want easy, medium, hard or veryhard)", s)
+}
+
+// UtilityKind is what an AI maximises.
+type UtilityKind uint8
+
+const (
+	// UtilityOwn maximises the AI's own final score.
+	UtilityOwn UtilityKind = iota
+	// UtilityBeatLeader maximises the margin over the best other player, whoever leads.
+	UtilityBeatLeader
+	// UtilityCoalition makes every AI play for the AI team against the human(s): the reward is the
+	// best AI score minus the best human score, shared by all AI seats (Very Hard, disclosed in the lobby).
+	UtilityCoalition
+)
+
+// Profile holds every knob a level turns.
+type Profile struct {
+	Level   Level
+	Utility UtilityKind
+
+	Search  bool          // false: 1-ply greedy policy only (Easy)
+	Budget  time.Duration // think time per decision (search levels)
+	Workers int           // parallel search trees (each with its own deck samples)
+
+	RootTemp   float64 // softmax temperature for the final choice (0 = best only)
+	RootWindow float64 // only moves within this many points of the best are candidates (0 = all)
+
+	Epsilon           float64 // ε-greedy exploration inside rollouts
+	RolloutTurns      int     // rollout length in whole rounds before the evaluation cut-off
+	OppModel          bool    // plan recognition + denial
+	EndgameToTerminal bool    // near the end, roll out to the actual end of the game
+
+	CPuct    float64 // PUCT exploration constant
+	MaxNodes int     // node cap per search tree
+
+	Weights *Weights // evaluator weights (nil = DefaultWeights); tuning experiments only
+}
+
+// DefaultProfile returns the tuned defaults for a level (see docs/ai/tinh-chinh.md).
+func DefaultProfile(l Level) Profile {
+	switch l {
+	case Easy:
+		return Profile{Level: Easy, Utility: UtilityOwn, RootTemp: 1.5, RootWindow: 3}
+	case Medium:
+		return Profile{Level: Medium, Utility: UtilityOwn, Search: true, Budget: 300 * time.Millisecond,
+			Workers: 1, RootTemp: 0.4, Epsilon: 0.25, RolloutTurns: 2, CPuct: 0.8, MaxNodes: 200000}
+	case Hard:
+		return Profile{Level: Hard, Utility: UtilityBeatLeader, Search: true, Budget: 1400 * time.Millisecond,
+			Workers: 2, Epsilon: 0.15, RolloutTurns: 2, OppModel: true, CPuct: 0.8, MaxNodes: 200000}
+	case VeryHard:
+		return Profile{Level: VeryHard, Utility: UtilityCoalition, Search: true, Budget: 3000 * time.Millisecond,
+			Workers: 4, Epsilon: 0.10, RolloutTurns: 2, OppModel: true, EndgameToTerminal: true,
+			CPuct: 0.8, MaxNodes: 200000}
+	}
+	return DefaultProfile(Medium)
+}
+
+// Scaled returns the profile with its think time multiplied by pct/100 (AI_THINK_SCALE_PCT).
+func (p Profile) Scaled(pct int) Profile {
+	if pct <= 0 || pct == 100 {
+		return p
+	}
+	p.Budget = p.Budget * time.Duration(pct) / 100
+	return p
+}
--- a/internal/ai/scheduler.go
+++ b/internal/ai/scheduler.go
@@ -0,0 +1,95 @@
+package ai
+
+import (
+	"context"
+	"runtime"
+	"time"
+)
+
+// Scheduler is a server-wide pool of search threads. Every search must hold at least one token
+// per worker goroutine it runs, so concurrent AI turns in different games never oversubscribe the
+// CPU (the production host is a phone with 4 fast cores). A nil *Scheduler grants everything.
+type Scheduler struct {
+	tokens chan struct{}
+}
+
+// NewScheduler creates a pool of max tokens; max <= 0 means auto: min(4, NumCPU/2), at least 1.
+func NewScheduler(max int) *Scheduler {
+	if max <= 0 {
+		max = min(4, runtime.NumCPU()/2)
+	}
+	if max < 1 {
+		max = 1
+	}
+	s := &Scheduler{tokens: make(chan struct{}, max)}
+	for i := 0; i < max; i++ {
+		s.tokens <- struct{}{}
+	}
+	return s
+}
+
+// Capacity returns the pool size (0 for a nil scheduler).
+func (s *Scheduler) Capacity() int {
+	if s == nil {
+		return 0
+	}
+	return cap(s.tokens)
+}
+
+// Acquire waits for one token (or ctx), then takes up to want-1 more without waiting. It returns
+// the number granted (0 if ctx ended first) and a release func that must be called exactly once.
+func (s *Scheduler) Acquire(ctx context.Context, want int) (int, func()) {
+	if want < 1 {
+		want = 1
+	}
+	if s == nil {
+		return want, func() {}
+	}
+	select {
+	case <-s.tokens:
+	case <-ctx.Done():
+		return 0, func() {}
+	}
+	got := 1
+	for got < want {
+		select {
+		case <-s.tokens:
+			got++
+			continue
+		default:
+		}
+		break
+	}
+	n := got
+	return got, func() {
+		for i := 0; i < n; i++ {
+			s.tokens <- struct{}{}
+		}
+	}
+}
+
+// Runtime is the server-wide AI context shared by all agents.
+type Runtime struct {
+	Sched    *Scheduler
+	ScalePct int           // multiplies every think budget (AI_THINK_SCALE_PCT, 100 = as tuned)
+	MaxNodes int           // node cap per search tree (AI_MAX_NODES; 0 = profile default)
+	MinDelay time.Duration // minimum visible "thinking" time per AI move (AI_MIN_DELAY_MS)
+}
+
+// DefaultRuntime is used when no runtime is configured (tests, CLI).
+func DefaultRuntime() *Runtime {
+	return &Runtime{Sched: nil, ScalePct: 100, MinDelay: 0}
+}
+
+// Profile returns the level's profile adjusted by the runtime settings.
+func (rt *Runtime) Profile(l Level) Profile {
+	p := DefaultProfile(l)
+	if rt == nil {
+		return p
+	}
+	p = p.Scaled(rt.ScalePct)
+	if rt.MaxNodes > 0 {
+		p.MaxNodes = rt.MaxNodes
+	}
+	return p
+}
--- a/internal/ai/search_agent.go
+++ b/internal/ai/search_agent.go
@@ -0,0 +1,332 @@
+package ai
+
+import (
+	"context"
+	"math"
+	"math/rand/v2"
+	"sync"
+	"time"
+
+	"golem_century/internal/ai/sim"
+	"golem_century/internal/game"
+)
+
+// searchAgent is the agent for every level: Easy uses the 1-ply policy only, the others run an
+// ensemble of open-loop MCTS trees (one per worker, each with its own refill samples) and pick
+// by aggregated root visits.
+type searchAgent struct {
+	p      Profile
+	rt     *Runtime
+	ev     evaluator
+	intent intentTracker
+}
+
+func newSearchAgent(p Profile, rt *Runtime) *searchAgent {
+	ev := newEvaluator()
+	if p.Weights != nil {
+		ev.w = *p.Weights
+	}
+	return &searchAgent{p: p, rt: rt, ev: ev}
+}
+
+func (a *searchAgent) Level() Level     { return a.p.Level }
+func (a *searchAgent) Profile() Profile { return a.p }
+
+var nodePool = sync.Pool{New: func() any { return &[]node{} }}
+
+func (a *searchAgent) Decide(ctx context.Context, snap *game.GameState, o DecideOptions) (Decision, error) {
+	start := time.Now()
+	st, err := sim.FromGame(snap)
+	if err != nil {
+		d := greedyDecide(snap, a.p, rand.New(rand.NewPCG(o.Seed, 1)), evalGame)
+		d.Stats.Fallback = err.Error()
+		return d, nil
+	}
+	seat := st.Seat()
+	n := int(st.N)
+	pv := newPerspective(n, seat, a.p, o.Teams)
+	pl := policy{ev: a.ev, denialWeight: 0.5}
+	if a.p.OppModel {
+		pl.denial = denialTargets(&st, seat, &pv, a.ev)
+	}
+	rng := rand.New(rand.NewPCG(o.Seed, 0xa1))
+	drawer := sim.RandDrawer{R: rng}
+
+	legal := st.AppendLegal(nil, sim.Search)
+	var chosen sim.Action
+	stats := SearchStats{}
+	switch {
+	case len(legal) == 0:
+		return Decision{Action: game.Action{Type: game.Rest}, Stats: SearchStats{Fallback: "no legal moves"}}, nil
+	case len(legal) == 1:
+		chosen = legal[0]
+	default:
+		if w, ok := immediateWin(&st, legal, &pv, drawer); ok {
+			chosen = w
+			break
+		}
+		if c, ok := antiStall(&st, legal); ok {
+			chosen = c
+			stats.Fallback = "anti-stall claim"
+			break
+		}
+		if !a.p.Search {
+			chosen = a.greedyPick(&st, legal, &pl, drawer, rng)
+			break
+		}
+		var ok bool
+		chosen, stats, ok = a.search(ctx, &st, &pv, pl, o, start)
+		if !ok {
+			if ctx.Err() != nil {
+				return Decision{}, ctx.Err()
+			}
+			chosen = a.greedyPick(&st, legal, &pl, drawer, rng)
+			stats.Fallback = "search produced no move"
+		}
+	}
+
+	ga, err := sim.ToGameAction(snap, chosen)
+	if err != nil {
+		return Decision{}, err
+	}
+	d := Decision{Action: ga, Stats: stats}
+	// pick the discard if this move overflows the caravan
+	after := st
+	after.Apply(chosen, drawer)
+	if after.P[seat].Pending > 0 && !after.Over {
+		before := after
+		pl.bestDiscard(&after, drawer)
+		var disc sim.Crystals
+		for c := 0; c < 4; c++ {
+			disc[c] = before.P[seat].Res[c] - after.P[seat].Res[c]
+		}
+		d.Discard = &game.Resources{Yellow: int(disc[0]), Green: int(disc[1]), Blue: int(disc[2]), Pink: int(disc[3])}
+	}
+	d.Intents = a.intent.detect(&st, chosen, seat, &pv, a.p, a.ev, o.Teams)
+	d.Stats.Elapsed = time.Since(start)
+	return d, nil
+}
+
+// greedyPick is the 1-ply policy: evaluate every move for the mover (denial included when the
+// profile models opponents), drop root blunders, then softmax within the profile's window.
+func (a *searchAgent) greedyPick(st *sim.State, legal []sim.Action, pl *policy, d sim.Drawer, rng *rand.Rand) sim.Action {
+	scores := make([]float64, len(legal))
+	pl.fullScores(st, legal, d, scores)
+	applyRootGuard(st, legal, scores)
+	best := 0
+	for i := range scores {
+		if scores[i] > scores[best] {
+			best = i
+		}
+	}
+	if a.p.RootTemp <= 0 {
+		return legal[best]
+	}
+	weights := make([]float64, len(scores))
+	total := 0.0
+	for i, v := range scores {
+		if math.IsInf(v, -1) || (a.p.RootWindow > 0 && scores[best]-v > a.p.RootWindow) {
+			continue
+		}
+		weights[i] = math.Exp((v - scores[best]) / a.p.RootTemp)
+		total += weights[i]
+	}
+	r := rng.Float64() * total
+	for i, w := range weights {
+		if r < w {
+			return legal[i]
+		}
+		r -= w
+	}
+	return legal[best]
+}
+
+// search runs the MCTS ensemble and returns the chosen root move.
+func (a *searchAgent) search(ctx context.Context, st *sim.State, pv *perspective, pl policy, o DecideOptions, start time.Time) (sim.Action, SearchStats, bool) {
+	var sched *Scheduler
+	if a.rt != nil {
+		sched = a.rt.Sched
+	}
+	got, release := sched.Acquire(ctx, max(1, a.p.Workers))
+	defer release()
+	if got == 0 {
+		return sim.Action{}, SearchStats{}, false
+	}
+	deadline := start.Add(a.p.Budget)
+	perWorker := 0
+	if o.Iterations > 0 {
+		perWorker = max(1, o.Iterations/got)
+	}
+
+	trees := make([]*tree, got)
+	var wg sync.WaitGroup
+	for w := 0; w < got; w++ {
+		buf := nodePool.Get().(*[]node)
+		t := newTree(a.p, *pv, pl, o.Seed, uint64(w)+1, *buf)
+		trees[w] = t
+		wg.Add(1)
+		go func(t *tree) {
+			defer wg.Done()
+			t.reset(st)
+			for i := 0; ; i++ {
+				if perWorker > 0 {
+					if i >= perWorker {
+						return
+					}
+				} else if i&127 == 0 && (ctx.Err() != nil || time.Now().After(deadline)) {
+					return
+				}
+				t.iterate(st)
+			}
+		}(t)
+	}
+	wg.Wait()
+
+	// aggregate root children by move
+	type agg struct {
+		act    sim.Action
+		visits uint32
+		prior  float32
+	}
+	byKey := map[uint64]*agg{}
+	order := []uint64{}
+	stats := SearchStats{Workers: got}
+	for _, t := range trees {
+		stats.Iterations += t.iters
+		stats.Nodes += len(t.nodes)
+		if len(t.nodes) > 0 {
+			for c := t.nodes[0].first; c >= 0; c = t.nodes[c].next {
+				ch := &t.nodes[c]
+				g, ok := byKey[ch.key]
+				if !ok {
+					g = &agg{act: ch.act, prior: ch.prior}
+					byKey[ch.key] = g
+					order = append(order, ch.key)
+				}
+				g.visits += ch.visits
+			}
+		}
+		nodes := t.nodes[:0]
+		nodePool.Put(&nodes)
+	}
+	if len(order) == 0 {
+		return sim.Action{}, stats, false
+	}
+	best := byKey[order[0]]
+	for _, k := range order[1:] {
+		g := byKey[k]
+		if g.visits > best.visits || (g.visits == best.visits && g.prior > best.prior) {
+			best = g
+		}
+	}
+	if a.p.RootTemp > 0 && best.visits > 0 {
+		// visit-count softmax: P ∝ visits^(1/τ)
+		rng := rand.New(rand.NewPCG(o.Seed, 0xb2))
+		total := 0.0
+		w := make([]float64, len(order))
+		for i, k := range order {
+			w[i] = math.Pow(float64(byKey[k].visits)/float64(best.visits), 1/a.p.RootTemp)
+			total += w[i]
+		}
+		r := rng.Float64() * total
+		for i, k := range order {
+			if r < w[i] {
+				return byKey[k].act, stats, true
+			}
+			r -= w[i]
+		}
+	}
+	return best.act, stats, true
+}
+
+// immediateWin returns a move that ends the game with the mover (or its coalition) winning.
+func immediateWin(st *sim.State, legal []sim.Action, pv *perspective, d sim.Drawer) (sim.Action, bool) {
+	if !st.LastRound {
+		return sim.Action{}, false
+	}
+	mover := st.Seat()
+	best, bestPts, found := sim.Action{}, -1, false
+	for _, a := range legal {
+		c := *st
+		c.Apply(a, d)
+		if !c.Over {
+			continue
+		}
+		w := int(c.Winner)
+		mine := w == mover || (pv.kind[mover] == UtilityCoalition && pv.isAI[w])
+		if mine && c.P[mover].FinalPoints() > bestPts {
+			best, bestPts, found = a, c.P[mover].FinalPoints(), true
+		}
+	}
+	return best, found
+}
+
+// denialTargets marks whose losses count as gains in the priors: the leader (beat-the-leader)
+// or every human (coalition).
+func denialTargets(st *sim.State, seat int, pv *perspective, ev evaluator) [sim.MaxPlayers]bool {
+	var out [sim.MaxPlayers]bool
+	if pv.kind[seat] == UtilityCoalition {
+		for i := 0; i < int(st.N); i++ {
+			out[i] = !pv.isAI[i]
+		}
+		return out
+	}
+	var v [sim.MaxPlayers]float64
+	ev.values(st, &v)
+	leader := -1
+	for i := 0; i < int(st.N); i++ {
+		if i != seat && (leader < 0 || v[i] > v[leader]) {
+			leader = i
+		}
+	}
+	if leader >= 0 && v[leader] >= v[seat]-2 {
+		out[leader] = true
+	}
+	return out
+}
+
+// antiStallRound: past this round the AI stops "investing": it takes the best available claim,
+// else the move that brings it closest to its most reachable golem. Real games end around rounds
+// 35–70; this only guards against AIs waiting each other out (observed ~1 in 2000 AI-only games,
+// e.g. caravans full of pink while the golem row wants green and yellow).
+const antiStallRound = 100
+
+func antiStall(st *sim.State, legal []sim.Action) (sim.Action, bool) {
+	if st.Round < antiStallRound {
+		return sim.Action{}, false
+	}
+	best, bestPts, found := sim.Action{}, -1, false
+	for _, a := range legal {
+		if a.Kind == sim.AClaim {
+			if p := int(sim.Golems[st.Row[a.Card]].Points); p > bestPts {
+				best, bestPts, found = a, p, true
+			}
+		}
+	}
+	if found {
+		return best, true
+	}
+	seat := st.Seat()
+	bestCost := 1 << 30
+	for _, a := range legal {
+		c := *st
+		c.Apply(a, noDraw{})
+		if a.Kind == sim.ARest && st.P[seat].Played == 0 {
+			continue
+		}
+		cost := 1 << 30
+		for j := 0; j < int(c.NRow); j++ {
+			cost = min(cost, deficit(c.P[seat].Res, sim.Golems[c.Row[j]].Req))
+		}
+		if cost < bestCost {
+			best, bestCost, found = a, cost, true
+		}
+	}
+	return best, found
+}
+
+// deficit is the crystal-level cost still missing for a golem (spare crystals upgraded first),
+// i.e. the numerator of turnsToAfford.
+func deficit(res, req sim.Crystals) int {
+	return turnsToAfford(res, req, 1) - 1
+}
