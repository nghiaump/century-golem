+// AutoDiscard picks n crystals to discard, cheapest colours first. Returns nil if impossible.
+func AutoDiscard(res *Resources, n int) *Resources {
+	if n <= 0 || res.Total() < n {
+		return nil
+	}
+	d := NewResources()
+	for c := Yellow; c <= Pink && n > 0; c++ {
+		take := min(res.Get(c), n)
+		d.Add(c, take)
+		n -= take
+	}
+	return d
