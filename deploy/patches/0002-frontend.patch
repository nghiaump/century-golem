+      {which === 'claim' && <ConfirmGolemModal isOpen golem={golem(124, 17, { yellow: 2, blue: 2, pink: 2 })} coin="copper" onConfirm={noop} onCancel={noop} />}
+      {which === 'gameover' && <GameOverModal onNewGame={noop} onBackToMenu={noop} />}
+    </div>
+  )
+}
