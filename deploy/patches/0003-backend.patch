+	if gs.config == nil || gs.config.MaxSessions <= 0 {
+		return false
+	}
+	gs.mu.RLock()
+	defer gs.mu.RUnlock()
+	return len(gs.SessionsV2) >= gs.config.MaxSessions
+}
