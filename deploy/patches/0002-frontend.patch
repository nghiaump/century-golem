@@ -0,0 +1,349 @@
+/*
+ * Windows XP × brutalism theme for the pre-game screens: mode menu, lobbies, connecting dialog, waiting room.
+ * XP: Luna blue title bars, beige window face, Tahoma, green "go" buttons, marquee progress bar.
+ * Brutalism: thick black borders, hard offset shadows, flat colours, no glass/blur.
+ * System fonts only — no web fonts or other external requests (see docs/privacy.md).
+ */
+:root {
+  --xp-ink: #0b0b0b;
+  --xp-face: #ece9d8;
+  --xp-face-dark: #d8d4c4;
+  --xp-paper: #ffffff;
+  --xp-blue: #0054e3;
+  --xp-select: #316ac5;
+  --xp-hover: #e8eef9;
+  --xp-orange: #ffc83c;
+  --xp-smb-sky: #9290ff;
+  --xp-shadow: 6px 6px 0 var(--xp-ink);
+  --xp-font: Tahoma, Verdana, "DejaVu Sans", "Segoe UI", sans-serif;
+  --xp-title-font: "Trebuchet MS", Tahoma, Verdana, "DejaVu Sans", sans-serif;
+}
+
+/* ---- Desktop (page background): flat, hard-edged take on the XP "Bliss" hill ---- */
+.xp-desktop {
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 24px 16px;
+  background:
+    radial-gradient(150% 55% at 25% 108%, #5aa632 0 54%, #3f8a22 54.2% 57%, transparent 57.2%),
+    linear-gradient(180deg, #1f63d1 0%, #4a8ee6 45%, #9cc8f2 100%);
+  background-attachment: fixed;
+  font-family: var(--xp-font);
+  color: var(--xp-ink);
+}
+
+/* ---- Window chrome ---- */
+.xp-window {
+  width: 100%;
+  background: var(--xp-face);
+  border: 3px solid var(--xp-ink);
+  border-radius: 8px 8px 0 0;
+  box-shadow: var(--xp-shadow);
+  font-family: var(--xp-font);
+  color: var(--xp-ink);
+  font-size: 14px;
+}
+.xp-titlebar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 5px 6px 5px 10px;
+  border-radius: 5px 5px 0 0;
+  border-bottom: 3px solid var(--xp-ink);
+  background: linear-gradient(180deg, #3d95ff 0%, #0a64e8 12%, #0054e3 45%, #0050d8 80%, #0a3fa8 100%);
+  color: #fff;
+  font: bold 15px/1.3 var(--xp-title-font);
+  text-shadow: 1px 1px 0 #0a1a6a;
+}
+.xp-titlebar-icon {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+  border: 1.5px solid #fff;
+  background: var(--xp-smb-sky);
+}
+.xp-titlebar-title {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.xp-title-btn {
+  width: 24px;
+  height: 24px;
+  flex-shrink: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 2px solid #fff;
+  border-radius: 4px;
+  background: linear-gradient(180deg, #f39a7d 0%, #e0532c 55%, #c4320f 100%);
+  color: #fff;
+  font: bold 14px/1 var(--xp-font);
+  cursor: pointer;
+}
+.xp-title-btn:hover { filter: brightness(1.12); }
+.xp-title-btn:active { filter: brightness(0.9); }
+.xp-body { padding: 18px; }
+.xp-statusbar {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 4px 10px;
+  border-top: 2px solid var(--xp-ink);
+  background: var(--xp-face-dark);
+  font-size: 11px;
+}
+.xp-heading {
+  margin: 0 0 14px;
+  font: bold 22px/1.15 var(--xp-title-font);
+  letter-spacing: -0.01em;
+}
+.xp-heading small {
+  display: block;
+  margin-top: 3px;
+  font: 12px/1.3 var(--xp-font);
+  letter-spacing: 0;
+  color: #44443c;
+}
+
+/* ---- Buttons ---- */
+.xp-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: 36px;
+  padding: 7px 16px;
+  font: 13px/1.2 var(--xp-font);
+  color: var(--xp-ink);
+  background: linear-gradient(180deg, #ffffff 0%, #f4f3ee 55%, #e3e0d4 100%);
+  border: 2px solid var(--xp-ink);
+  border-radius: 4px;
+  box-shadow: 3px 3px 0 var(--xp-ink);
+  cursor: pointer;
+  user-select: none;
+  white-space: nowrap;
+}
+.xp-btn:hover:not(:disabled) { background: linear-gradient(180deg, #ffffff 0%, #fdf3d8 55%, #f6d998 100%); }
+.xp-btn:active:not(:disabled) { transform: translate(3px, 3px); box-shadow: none; }
+.xp-btn:focus-visible { outline: 2px dotted var(--xp-ink); outline-offset: -6px; }
+.xp-btn:disabled {
+  color: #8c8c86;
+  border-color: #8c8c86;
+  background: #f2f1ea;
+  box-shadow: none;
+  cursor: not-allowed;
+}
+.xp-btn--go {
+  color: #fff;
+  font-weight: bold;
+  font-style: italic;
+  font-size: 15px;
+  text-shadow: 1px 1px 0 #1b4d1b;
+  background: linear-gradient(180deg, #62c862 0%, #3a9e3a 45%, #2f8a2f 100%);
+}
+.xp-btn--go:hover:not(:disabled) { background: linear-gradient(180deg, #78d878 0%, #45ad45 45%, #36953a 100%); }
+.xp-btn--go:disabled { text-shadow: none; font-style: normal; }
+.xp-btn--block { width: 100%; }
+.xp-btn--lg { min-height: 48px; padding: 10px 22px; font-size: 17px; }
+.xp-btn--sm { min-height: 30px; padding: 4px 10px; font-size: 12px; box-shadow: 2px 2px 0 var(--xp-ink); }
+.xp-btn--sm:active:not(:disabled) { transform: translate(2px, 2px); }
+
+/* Big menu choices */
+.xp-tile {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  width: 100%;
+  padding: 12px 14px;
+  text-align: left;
+  background: var(--xp-paper);
+  border: 3px solid var(--xp-ink);
+  box-shadow: 5px 5px 0 var(--xp-ink);
+  font-family: var(--xp-font);
+  color: var(--xp-ink);
+  cursor: pointer;
+}
+.xp-tile:hover { background: #fffbe6; }
+.xp-tile:active { transform: translate(5px, 5px); box-shadow: none; }
+.xp-tile:focus-visible { outline: 3px solid var(--xp-orange); outline-offset: 2px; }
+.xp-tile-icons { display: flex; flex-shrink: 0; }
+.xp-tile-icons img {
+  width: 52px;
+  height: 52px;
+  border: 2px solid var(--xp-ink);
+  background: var(--xp-smb-sky);
+}
+.xp-tile-icons img + img { margin-left: -14px; }
+.xp-tile-title { display: block; font: bold 18px/1.2 var(--xp-title-font); }
+.xp-tile-sub { display: block; margin-top: 2px; font-size: 12px; color: #44443c; }
+.xp-tile-arrow { margin-left: auto; font: bold 22px/1 var(--xp-font); }
+
+/* ---- Form controls ---- */
+.xp-field-label {
+  display: block;
+  margin-bottom: 6px;
+  font: bold 11px/1.2 var(--xp-font);
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+}
+.xp-group {
+  position: relative;
+  padding: 16px 12px 12px;
+  border: 2px solid var(--xp-ink);
+}
+.xp-group-title {
+  position: absolute;
+  top: -10px;
+  left: 10px;
+  padding: 0 6px;
+  background: var(--xp-face);
+  color: var(--xp-blue);
+  font: bold 12px/18px var(--xp-font);
+}
+.xp-input,
+.xp-select {
+  width: 100%;
+  min-height: 36px;
+  padding: 6px 10px;
+  font: 14px/1.2 var(--xp-font);
+  color: var(--xp-ink);
+  background: var(--xp-paper);
+  border: 2px solid var(--xp-ink);
+  border-radius: 0;
+  box-shadow: inset 2px 2px 0 rgba(0, 0, 0, 0.12);
+}
+.xp-input:focus,
+.xp-select:focus { outline: 3px solid var(--xp-orange); outline-offset: 0; }
+.xp-input::placeholder { color: #7a7a72; }
+.xp-input--mono { font-family: "Lucida Console", "DejaVu Sans Mono", monospace; font-size: 12px; }
+
+/* Tabs */
+.xp-tabs { display: flex; gap: 4px; margin-bottom: 18px; border-bottom: 3px solid var(--xp-ink); }
+.xp-tab {
+  position: relative;
+  margin-bottom: -3px;
+  padding: 8px 16px;
+  font: bold 13px/1.2 var(--xp-font);
+  color: #3a3a34;
+  background: var(--xp-face-dark);
+  border: 2px solid var(--xp-ink);
+  border-bottom: 3px solid var(--xp-ink);
+  cursor: pointer;
+}
+.xp-tab:hover { background: #e6e2d2; }
+.xp-tab[aria-selected="true"] {
+  z-index: 1;
+  padding-top: 6px;
+  color: var(--xp-ink);
+  background: var(--xp-face);
+  border-top: 4px solid var(--xp-orange);
+  border-bottom-color: var(--xp-face);
+}
+
+/* Option list (radio rows) */
+.xp-list { background: var(--xp-paper); border: 2px solid var(--xp-ink); }
+.xp-list-item {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 10px;
+  border-bottom: 1px dotted #9a9a90;
+  cursor: pointer;
+}
+.xp-list-item:last-child { border-bottom: none; }
+.xp-list-item:hover { background: var(--xp-hover); }
+.xp-list-item[data-selected="true"] { background: var(--xp-select); color: #fff; }
+.xp-list-item input[type="radio"] { width: 16px; height: 16px; accent-color: #2f8a2f; }
+
+/* Avatar picker */
+.xp-avatar-grid {
+  display: grid;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  gap: 8px;
+}
+.xp-avatar {
+  aspect-ratio: 1;
+  padding: 0;
+  overflow: hidden;
+  background: var(--xp-smb-sky);
+  border: 2px solid var(--xp-ink);
+  box-shadow: 2px 2px 0 var(--xp-ink);
+  cursor: pointer;
+}
+.xp-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.xp-avatar:hover { border-color: var(--xp-select); }
+.xp-avatar[aria-pressed="true"] {
+  outline: 4px solid var(--xp-orange);
+  outline-offset: 0;
+  border-color: var(--xp-ink);
+  box-shadow: 4px 4px 0 var(--xp-ink);
+}
+
+/* Notes / balloons */
+.xp-note { padding: 8px 10px; font-size: 12px; background: #ffffe1; border: 2px solid var(--xp-ink); }
+.xp-note--ok { background: #e3f5d9; }
+.xp-note--err { background: #ffe3dc; }
+
+/* Room list (list view) */
+.xp-listview { max-height: 50vh; overflow-y: auto; background: var(--xp-paper); border: 2px solid var(--xp-ink); }
+.xp-row { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px dotted #9a9a90; }
+.xp-row:last-child { border-bottom: none; }
+.xp-row:hover { background: var(--xp-hover); }
+.xp-row--expiring { background: #fff0ec; }
+.xp-empty { padding: 28px 12px; text-align: center; color: #55554c; }
+.xp-badge {
+  display: inline-block;
+  padding: 1px 6px;
+  font: bold 11px/1.4 var(--xp-font);
+  background: var(--xp-paper);
+  border: 1.5px solid var(--xp-ink);
+}
+.xp-badge--green { background: #b9f3b0; }
+.xp-badge--blue { background: #cfe0ff; }
+.xp-badge--orange { background: #ffe2a8; }
+.xp-badge--red { background: #ffc9bd; }
+/* badges keep dark text inside a selected (blue, white-text) list row — difficulty picker */
+.xp-list-item .xp-badge { color: var(--xp-ink); }
+
+/* XP marquee progress bar */
+.xp-progress {
+  position: relative;
+  height: 20px;
+  overflow: hidden;
+  background: var(--xp-paper);
+  border: 2px solid var(--xp-ink);
+}
+.xp-progress::before {
+  content: "";
+  position: absolute;
+  top: 3px;
+  bottom: 3px;
+  left: -64px;
+  width: 64px;
+  background: repeating-linear-gradient(90deg, #37b737 0 9px, transparent 9px 12px);
+  animation: xp-marquee 1.6s linear infinite;
+}
+@keyframes xp-marquee { to { left: 100%; } }
+
+.xp-actions { display: flex; flex-wrap: wrap; gap: 10px; }
+.xp-stack > * + * { margin-top: 16px; }
+.xp-muted { color: #55554c; font-size: 12px; }
+
+@media (max-width: 480px) {
+  .xp-desktop { padding: 16px 12px; }
+  .xp-window { width: calc(100% - 4px); box-shadow: 4px 4px 0 var(--xp-ink); } /* leave room for the shadow */
+  .xp-body { padding: 14px 12px; }
+  .xp-heading { font-size: 19px; }
+  .xp-tile-icons img { width: 44px; height: 44px; }
+  .xp-tile-title { font-size: 16px; }
+  .xp-avatar-grid { gap: 6px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .xp-progress::before { animation: none; left: 0; width: 100%; }
+}
