+package ai
+
+import (
+	"context"
+	"math/rand"
+	"testing"
+	"time"
+
+	"golem_century/internal/game"
+)
+
+// testProfile is a level's profile with a single worker (deterministic with an iteration budget).
+func testProfile(l Level) Profile {
+	p := DefaultProfile(l)
+	p.Workers = 1
+	return p
+}
+
+func decide(t *testing.T, a Agent, gs *game.GameState, iters int, teams []int) Decision {
+	t.Helper()
+	d, err := a.Decide(context.Background(), gs.Clone(), DecideOptions{Seed: 7, Iterations: iters, Teams: teams})
+	if err != nil {
+		t.Fatalf("decide: %v", err)
+	}
+	if _, err := gs.Clone().Validate(d.Action); err != nil {
+		t.Fatalf("decision %+v is illegal: %v", d.Action, err)
+	}
+	return d
+}
+
+func TestSearchAgents_PlayLegalCompleteGames(t *testing.T) {
+	for _, l := range AllLevels {
+		for n := 2; n <= 4; n++ {
+			gs := game.NewGameState(n, int64(300+n))
+			agents := make([]Agent, n)
+			for i := range agents {
+				p := testProfile(l)
+				agents[i] = NewAgentWithProfile(p, DefaultRuntime())
+			}
+			// small iteration budgets keep the test fast; legality is what matters here
+			for step := 0; step < 3000 && !gs.GameOver; step++ {
+				seat := gs.CurrentTurn % n
+				d, err := agents[seat].Decide(context.Background(), gs.Clone(), DecideOptions{Seed: uint64(step), Iterations: 60})
+				if err != nil {
+					t.Fatalf("%v %dp step %d: %v", l, n, step, err)
+				}
+				res, err := gs.Step(d.Action)
+				if err != nil {
+					t.Fatalf("%v %dp step %d: illegal %+v: %v", l, n, step, d.Action, err)
+				}
+				if res.PendingDiscard > 0 {
+					disc := d.Discard
+					if disc == nil {
+						t.Fatalf("%v: overflowing move without a discard choice", l)
+					}
+					if _, err := gs.Step(game.Action{Type: game.Discard, DiscardResources: disc}); err != nil {
+						t.Fatalf("%v: discard %v rejected: %v", l, disc, err)
+					}
+				}
+			}
+			if !gs.GameOver {
+				t.Fatalf("%v %dp: game did not finish", l, n)
+			}
+		}
+	}
+}
+
+func TestSearchAgent_DeterministicWithIterationBudget(t *testing.T) {
+	gs := game.NewGameState(3, 11)
+	a := NewAgentWithProfile(testProfile(Hard), DefaultRuntime())
+	b := NewAgentWithProfile(testProfile(Hard), DefaultRuntime())
+	d1 := decide(t, a, gs, 400, nil)
+	d2 := decide(t, b, gs, 400, nil)
+	if d1.Action.Type != d2.Action.Type || d1.Action.CardIndex != d2.Action.CardIndex || d1.Action.Multiplier != d2.Action.Multiplier {
+		t.Fatalf("same seed and budget must give the same move: %+v vs %+v", d1.Action, d2.Action)
+	}
+}
+
+func TestSearchAgent_IgnoresDeckOrder(t *testing.T) {
+	gs := game.NewGameState(4, 21)
+	// play a few moves so the position is not trivial
+	rng := rand.New(rand.NewSource(2))
+	for i := 0; i < 12; i++ {
+		acts := gs.LegalActions()
+		gs.Step(acts[rng.Intn(len(acts))])
+		if gs.GetCurrentPlayer().PendingDiscard > 0 {
+			p := gs.GetCurrentPlayer()
+			gs.Step(game.Action{Type: game.Discard, DiscardResources: game.AutoDiscard(p.Resources, p.PendingDiscard)})
+		}
+	}
+	other := gs.Clone()
+	rng.Shuffle(len(other.Market.ActionDeck), func(i, j int) {
+		other.Market.ActionDeck[i], other.Market.ActionDeck[j] = other.Market.ActionDeck[j], other.Market.ActionDeck[i]
+	})
+	rng.Shuffle(len(other.Market.PointDeck), func(i, j int) {
+		other.Market.PointDeck[i], other.Market.PointDeck[j] = other.Market.PointDeck[j], other.Market.PointDeck[i]
+	})
+	a := NewAgentWithProfile(testProfile(VeryHard), DefaultRuntime())
+	d1 := decide(t, a, gs, 500, nil)
+	d2 := decide(t, NewAgentWithProfile(testProfile(VeryHard), DefaultRuntime()), other, 500, nil)
+	if d1.Action.Type != d2.Action.Type || d1.Action.CardIndex != d2.Action.CardIndex {
+		t.Fatalf("the decision must not depend on the hidden deck order: %+v vs %+v", d1.Action, d2.Action)
+	}
+}
+
+func TestSearchAgent_CancelReturnsQuickly(t *testing.T) {
+	gs := game.NewGameState(4, 5)
+	a := NewAgent(VeryHard, &Runtime{ScalePct: 100})
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		a.Decide(ctx, gs.Clone(), DecideOptions{Seed: 1})
+		close(done)
+	}()
+	time.Sleep(100 * time.Millisecond)
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(300 * time.Millisecond):
+		t.Fatal("search must stop soon after cancellation")
+	}
+}
+
+// scenario builds a 2-player position where seat 0 (the AI) is to move.
+func scenario(t *testing.T, golems []string) *game.GameState {
+	t.Helper()
+	gs := game.NewGameState(2, 99)
+	row := make([]*game.Card, 0, len(golems))
+	for i, name := range golems {
+		row = append(row, game.CreateCardFromName(name, 101+i))
+	}
+	// keep IDs consistent with the deck: find the real cards by name
+	byName := map[string]*game.Card{}
+	for _, c := range append(append([]*game.Card{}, gs.Market.PointCards...), gs.Market.PointDeck...) {
+		byName[c.Name] = c
+	}
+	deck := []*game.Card{}
+	used := map[string]bool{}
+	for i, name := range golems {
+		c, ok := byName[name]
+		if !ok {
+			t.Fatalf("unknown golem %s", name)
+		}
+		row[i] = c
+		used[name] = true
+	}
+	for _, c := range append(append([]*game.Card{}, gs.Market.PointCards...), gs.Market.PointDeck...) {
+		if !used[c.Name] {
+			deck = append(deck, c)
+		}
+	}
+	gs.Market.PointCards = row
+	gs.Market.PointDeck = deck
+	return gs
+}
+
+// The human (seat 1) is one turn from a valuable golem the AI can claim right now: Hard (human
+// leading) and Very Hard (coalition) must take it.
+func TestScenario_DenyHumansTargetGolem(t *testing.T) {
+	for _, l := range []Level{Hard, VeryHard} {
+		gs := scenario(t, []string{"golem_0022", "golem_0230", "golem_3200", "golem_0040", "golem_2003"})
+		ai, human := gs.Players[0], gs.Players[1]
+		ai.Resources = &game.Resources{Blue: 2, Pink: 3}    // can claim golem_3200 (18 pts) now
+		human.Resources = &game.Resources{Blue: 2, Pink: 3} // …and so can the human, on their next turn
+		human.PointCards = []*game.Card{{ID: 9901, Type: game.PointCard, Points: 14}}
+		human.Points = 14
+		teams := []int{1, 100}
+		d := decide(t, NewAgentWithProfile(testProfile(l), DefaultRuntime()), gs, 1500, teams)
+		if d.Action.Type != game.ClaimPointCard || gs.Market.PointCards[d.Action.CardIndex].Name != "golem_3200" {
+			t.Errorf("%v should claim golem_3200 before the human, chose %+v", l, d.Action)
+		}
+	}
+}
+
+// Last copper coin: the AI should take the slot-0 golem when the human could take it next turn.
+func TestScenario_TakeLastCopper(t *testing.T) {
+	gs := scenario(t, []string{"golem_0302", "golem_0022", "golem_5000", "golem_4000", "golem_2220"})
+	gs.Market.Coins[0].Amount = 1
+	ai, human := gs.Players[0], gs.Players[1]
+	ai.Resources = &game.Resources{Yellow: 2, Blue: 3}
+	human.Resources = &game.Resources{Yellow: 2, Blue: 2, Green: 2}
+	d := decide(t, NewAgentWithProfile(testProfile(Hard), DefaultRuntime()), gs, 1500, []int{1, 100})
+	if d.Action.Type != game.ClaimPointCard || d.Action.CardIndex != 0 {
+		t.Errorf("Hard should take the last copper (golem 0), chose %+v", d.Action)
+	}
+}
+
+func TestScenario_TakesGameWinningClaim(t *testing.T) {
+	gs := scenario(t, []string{"golem_0022", "golem_5000", "golem_0230", "golem_3200", "golem_2003"})
+	gs.LastRound = true
+	gs.CurrentTurn = 1 // seat 1 (last seat) to move
+	me, other := gs.Players[1], gs.Players[0]
+	other.PointCards = []*game.Card{{ID: 9902, Type: game.PointCard, Points: 30}}
+	me.PointCards = []*game.Card{{ID: 9903, Type: game.PointCard, Points: 14}}
+	me.Resources = &game.Resources{Pink: 5}
+	d := decide(t, NewAgentWithProfile(testProfile(Medium), DefaultRuntime()), gs, 50, nil)
+	if d.Action.Type != game.ClaimPointCard || gs.Market.PointCards[d.Action.CardIndex].Name != "golem_5000" {
+		t.Fatalf("must take the claim that wins the game, chose %+v", d.Action)
+	}
+}
+
+func TestIntent_TookTargetGolem(t *testing.T) {
+	gs := scenario(t, []string{"golem_0022", "golem_0230", "golem_3200", "golem_0040", "golem_2003"})
+	ai, human := gs.Players[0], gs.Players[1]
+	ai.Resources = &game.Resources{Blue: 2, Pink: 3}
+	// The human can claim golem_3200 on their very next turn, so waiting would lose it. (With a
+	// 2-turn human the AI may correctly take a free card first and still claim in time.)
+	human.Resources = &game.Resources{Blue: 2, Pink: 3}
+	d := decide(t, NewAgentWithProfile(testProfile(VeryHard), DefaultRuntime()), gs, 1500, []int{1, 100})
+	if d.Action.Type != game.ClaimPointCard || gs.Market.PointCards[d.Action.CardIndex].Name != "golem_3200" {
+		t.Fatalf("Very Hard should claim the human's target golem_3200, chose %+v", d.Action)
+	}
+	if len(d.Intents) != 1 || d.Intents[0].TargetID != human.ID {
+		t.Fatalf("claiming the human's target should produce one intent for them, got %+v", d.Intents)
+	}
+}
+
+func TestAntiStall_MovesTowardsAGolem(t *testing.T) {
+	gs := scenario(t, []string{"golem_0050", "golem_0040", "golem_0032", "golem_0230", "golem_0222"})
+	gs.Round = 120
+	p := gs.GetCurrentPlayer()
+	p.Resources = &game.Resources{Pink: 9, Blue: 1}
+	p.Hand = append(p.Hand, game.CreateCardFromName("trade_1000_0030", 37)) // 1 pink → 3 green
+	d := decide(t, NewAgentWithProfile(testProfile(Medium), DefaultRuntime()), gs, 100, nil)
+	if d.Stats.Fallback != "anti-stall claim" {
+		t.Fatalf("past round 100 the anti-stall policy must decide, got %+v (%s)", d.Action, d.Stats.Fallback)
+	}
+	if d.Action.Type != game.PlayCard || p.Hand[d.Action.CardIndex].Name != "trade_1000_0030" {
+		t.Fatalf("expected the pink→green trade towards the green golems, got %+v", d.Action)
+	}
+}
--- a/internal/ai/sim/actions.go
+++ b/internal/ai/sim/actions.go
@@ -0,0 +1,190 @@
+package sim
+
+// ActKind is the kind of a move.
+type ActKind uint8
+
+const (
+	APlay ActKind = iota
+	AAcquire
+	AClaim
+	ARest
+	ADiscard
+)
+
+// Action is a move in canonical form.
+//   - APlay:    Card = merchant index; Mult = trade multiplier; Vec = crystals AFTER an upgrade.
+//   - AAcquire: Card = market position; Vec = multiset of crystals placed (cheapest on the left).
+//   - AClaim:   Card = golem row position.
+//   - ADiscard: Vec = crystals discarded.
+type Action struct {
+	Kind ActKind
+	Card uint8
+	Mult uint8
+	Vec  Crystals
+}
+
+// Key packs an action into a uint64 (unique per distinct action).
+func (a Action) Key() uint64 {
+	return uint64(a.Kind) | uint64(a.Card)<<8 | uint64(a.Mult)<<16 |
+		uint64(uint8(a.Vec[0]))<<24 | uint64(uint8(a.Vec[1]))<<32 |
+		uint64(uint8(a.Vec[2]))<<40 | uint64(uint8(a.Vec[3]))<<48
+}
+
+// GenMode selects how much of the combinatorics move generation enumerates.
+type GenMode uint8
+
+const (
+	// Full enumerates the same canonical set as game.AppendLegalActions with no limits.
+	Full GenMode = iota
+	// Search keeps at most 2 deposit variants per market position and 3 discard options.
+	Search
+)
+
+// AppendLegal appends the legal moves of the player to move.
+func (s *State) AppendLegal(dst []Action, mode GenMode) []Action {
+	if s.Over {
+		return dst
+	}
+	p := s.Cur()
+	if p.Pending > 0 {
+		var buf [msBufSize]Crystals
+		n := multisets(p.Res, int(p.Pending), &buf)
+		if mode == Search && n > 3 {
+			n = 3
+		}
+		for i := 0; i < n; i++ {
+			dst = append(dst, Action{Kind: ADiscard, Vec: buf[i]})
+		}
+		return dst
+	}
+
+	for h := p.Hand; h != 0; h &= h - 1 {
+		m := uint8(trailingZeros(h))
+		d := &Merchants[m]
+		switch d.Kind {
+		case KProduce:
+			dst = append(dst, Action{Kind: APlay, Card: m, Mult: 1})
+		case KUpgrade:
+			var buf [upBufSize]Crystals
+			n := upgradeResults(p.Res, d.Steps, &buf)
+			for i := 0; i < n; i++ {
+				dst = append(dst, Action{Kind: APlay, Card: m, Mult: 1, Vec: buf[i]})
+			}
+		case KTrade:
+			for t := int8(1); t <= p.Res.MaxTimes(d.In); t++ {
+				dst = append(dst, Action{Kind: APlay, Card: m, Mult: uint8(t)})
+			}
+		}
+	}
+
+	for k := 0; k < int(s.NMarket); k++ {
+		if k == 0 {
+			dst = append(dst, Action{Kind: AAcquire, Card: 0})
+			continue
+		}
+		var buf [msBufSize]Crystals
+		n := multisets(p.Res, k, &buf)
+		if mode == Search && n > 2 {
+			n = 2
+		}
+		for i := 0; i < n; i++ {
+			dst = append(dst, Action{Kind: AAcquire, Card: uint8(k), Vec: buf[i]})
+		}
+	}
+
+	for j := 0; j < int(s.NRow); j++ {
+		if p.Res.Covers(Golems[s.Row[j]].Req, 1) {
+			dst = append(dst, Action{Kind: AClaim, Card: uint8(j)})
+		}
+	}
+	return append(dst, Action{Kind: ARest})
+}
+
+const (
+	upBufSize = 64
+	msBufSize = 320
+)
+
+// upgradeResults writes every distinct crystal vector reachable with 1..steps single level-ups.
+func upgradeResults(res Crystals, steps int8, out *[upBufSize]Crystals) int {
+	n := 0
+	var frontier, next [upBufSize]Crystals
+	frontier[0] = res
+	nf := 1
+	for s := int8(0); s < steps; s++ {
+		nn := 0
+		for f := 0; f < nf; f++ {
+			v := frontier[f]
+			for c := 0; c < 3; c++ {
+				if v[c] == 0 {
+					continue
+				}
+				w := v
+				w[c]--
+				w[c+1]++
+				if w == res || contains(out[:n], w) {
+					continue
+				}
+				if n < upBufSize {
+					out[n] = w
+					n++
+				}
+				if nn < upBufSize {
+					next[nn] = w
+					nn++
+				}
+			}
+		}
+		frontier, nf = next, nn
+	}
+	return n
+}
+
+func contains(a []Crystals, v Crystals) bool {
+	for _, x := range a {
+		if x == v {
+			return true
+		}
+	}
+	return false
+}
+
+// multisets writes the distinct multisets of k crystals drawn from res, cheapest level first.
+func multisets(res Crystals, k int, out *[msBufSize]Crystals) int {
+	if k <= 0 || res.Total() < k {
+		return 0
+	}
+	n := 0
+	for y := 0; y <= min(int(res[0]), k); y++ {
+		for g := 0; g <= min(int(res[1]), k-y); g++ {
+			for b := 0; b <= min(int(res[2]), k-y-g); b++ {
+				p := k - y - g - b
+				if p <= int(res[3]) && n < msBufSize {
+					out[n] = Crystals{int8(y), int8(g), int8(b), int8(p)}
+					n++
+				}
+			}
+		}
+	}
+	// insertion sort by level (stable: equal levels keep enumeration order, like game.multisets)
+	for i := 1; i < n; i++ {
+		v := out[i]
+		lv := v.Level()
+		j := i - 1
+		for j >= 0 && out[j].Level() > lv {
+			out[j+1] = out[j]
+			j--
+		}
+		out[j+1] = v
+	}
+	return n
+}
+
+func trailingZeros(x uint64) int {
+	n := 0
+	for x&1 == 0 {
+		x >>= 1
+		n++
+	}
+	return n
+}
--- a/internal/ai/sim/cards.go
+++ b/internal/ai/sim/cards.go
@@ -0,0 +1,158 @@
+// Package sim is a compact, allocation-free copy of the Century: Golem rules used by the AI
+// search. internal/game stays the only authority for real games; a differential test
+// (sim_test.go) checks that both implementations agree after every step.
+//
+// The state is a plain value (~300 B): copying it is a struct copy, applying a move allocates
+// nothing. Deck order is never represented: unseen cards form an unordered pool and refills draw
+// from it through a Drawer, so a search cannot peek at the real deck by construction.
+package sim
+
+import (
+	"fmt"
+
+	"golem_century/internal/game"
+)
+
+// Crystals counts [yellow, green, blue, pink].
+type Crystals [4]int8
+
+// Total returns the number of crystals.
+func (c Crystals) Total() int { return int(c[0]) + int(c[1]) + int(c[2]) + int(c[3]) }
+
+// Level returns the summed crystal levels (yellow 1 … pink 4).
+func (c Crystals) Level() int { return int(c[0]) + 2*int(c[1]) + 3*int(c[2]) + 4*int(c[3]) }
+
+// Covers reports whether c holds at least m times r.
+func (c Crystals) Covers(r Crystals, m int8) bool {
+	return c[0] >= r[0]*m && c[1] >= r[1]*m && c[2] >= r[2]*m && c[3] >= r[3]*m
+}
+
+// MaxTimes returns how many times r fits into c (0 when r is empty).
+func (c Crystals) MaxTimes(r Crystals) int8 {
+	best := int8(-1)
+	for i := 0; i < 4; i++ {
+		if r[i] > 0 {
+			if t := c[i] / r[i]; best < 0 || t < best {
+				best = t
+			}
+		}
+	}
+	if best < 0 {
+		return 0
+	}
+	return best
+}
+
+// Kind is a merchant card kind.
+type Kind uint8
+
+const (
+	KProduce Kind = iota
+	KUpgrade
+	KTrade
+)
+
+// MerchantDef is a merchant (action) card.
+type MerchantDef struct {
+	Name  string
+	Kind  Kind
+	In    Crystals // trade input
+	Out   Crystals // produce/trade output
+	Steps int8     // upgrade steps
+}
+
+// GolemDef is a golem (point) card.
+type GolemDef struct {
+	Name   string
+	Req    Crystals
+	Points int8
+}
+
+const (
+	// Merchant indices 0..42 are the 43 deck cards (card ID − 1); 43 and 44 are every player's
+	// two starting cards (mint_0002 and upgrade_2).
+	NumDeckMerchants = 43
+	StartMint        = 43
+	StartUpgrade     = 44
+	NumMerchants     = 45
+	NumGolems        = 36 // golem index = card ID − 101
+	MarketSize       = 6
+	GolemRowSize     = 5
+	MaxPlayers       = 5
+	MaxCrystals      = game.MaxCrystals
+)
+
+// Merchants and Golems are built once from the reference engine's card lists (single source).
+var (
+	Merchants [NumMerchants]MerchantDef
+	Golems    [NumGolems]GolemDef
+)
+
+func init() {
+	deck := game.CreateDefaultActionCards()
+	if len(deck) != NumDeckMerchants {
+		panic(fmt.Sprintf("sim: expected %d merchant cards, engine has %d", NumDeckMerchants, len(deck)))
+	}
+	for i, c := range deck {
+		if c.ID != i+1 {
+			panic("sim: merchant card IDs must be 1..43 in list order")
+		}
+		Merchants[i] = merchantFromCard(c)
+	}
+	start := game.CreateInitialActionCards(0)
+	Merchants[StartMint] = merchantFromCard(start[0])
+	Merchants[StartUpgrade] = merchantFromCard(start[1])
+
+	golems := game.CreateDefaultPointCards()
+	if len(golems) != NumGolems {
+		panic(fmt.Sprintf("sim: expected %d golems, engine has %d", NumGolems, len(golems)))
+	}
+	for i, g := range golems {
+		if g.ID != 101+i {
+			panic("sim: golem IDs must be 101..136 in list order")
+		}
+		Golems[i] = GolemDef{Name: g.Name, Req: crystalsOf(g.Requirement), Points: int8(g.Points)}
+	}
+}
+
+func merchantFromCard(c *game.Card) MerchantDef {
+	d := MerchantDef{Name: c.Name}
+	switch c.ActionType {
+	case game.Produce:
+		d.Kind, d.Out = KProduce, crystalsOf(c.Output)
+	case game.Upgrade:
+		d.Kind, d.Steps = KUpgrade, int8(c.TurnUpgrade)
+	case game.Trade:
+		d.Kind, d.In, d.Out = KTrade, crystalsOf(c.Input), crystalsOf(c.Output)
+	}
+	return d
+}
+
+func crystalsOf(r *game.Resources) Crystals {
+	if r == nil {
+		return Crystals{}
+	}
+	return Crystals{int8(r.Yellow), int8(r.Green), int8(r.Blue), int8(r.Pink)}
+}
+
+// MerchantIndex maps an engine card to its merchant index.
+func MerchantIndex(c *game.Card) (uint8, bool) {
+	if c.ID >= 1 && c.ID <= NumDeckMerchants {
+		return uint8(c.ID - 1), true
+	}
+	switch c.Name {
+	case Merchants[StartMint].Name:
+		return StartMint, true
+	case Merchants[StartUpgrade].Name:
+		return StartUpgrade, true
+	}
+	return 0, false
+}
+
+// GolemIndex maps an engine golem card to its golem index.
+func GolemIndex(c *game.Card) (uint8, bool) {
+	if c.ID >= 101 && c.ID < 101+NumGolems {
+		return uint8(c.ID - 101), true
+	}
+	return 0, false
+}
