+++ b/web/react-frontend/src/theme-xp.css
@@ -345,3 +345,138 @@
 @media (prefers-reduced-motion: reduce) {
   .xp-progress::before { animation: none; left: 0; width: 100%; }
 }
+
+/* =====================================================================================================
+ * In-game board — same XP × brutalism language, denser. Card artwork stays as is; only chrome changes.
+ * ===================================================================================================== */
+
+/* Fixed page background behind the board (replaces the blurred photo) */
+.xp-game-bg {
+  position: fixed;
+  inset: 0;
+  z-index: 0;
+  background:
+    radial-gradient(150% 55% at 25% 108%, #5aa632 0 54%, #3f8a22 54.2% 57%, transparent 57.2%),
+    linear-gradient(180deg, #1f63d1 0%, #4a8ee6 45%, #9cc8f2 100%);
+}
+
+/* Panel = small XP window used for board areas (market, golems, hand, history, ...) */
+.xp-panel {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  background: var(--xp-face);
+  border: 3px solid var(--xp-ink);
+  box-shadow: 4px 4px 0 var(--xp-ink);
+  color: var(--xp-ink);
+  font-family: var(--xp-font);
+}
+.xp-panel-title {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  flex-shrink: 0;
+  padding: 2px 8px;
+  border-bottom: 2px solid var(--xp-ink);
+  background: linear-gradient(180deg, #3d95ff 0%, #0a64e8 12%, #0054e3 45%, #0050d8 80%, #0a3fa8 100%);
+  color: #fff;
+  font: bold 12px/18px var(--xp-title-font);
+  text-shadow: 1px 1px 0 #0a1a6a;
+  white-space: nowrap;
+}
+.xp-panel-title--muted { background: linear-gradient(180deg, #a7b3c8 0%, #7d8aa3 50%, #6b7891 100%); }
+.xp-panel-meta { margin-left: auto; font-weight: normal; font-size: 11px; }
+.xp-panel-body { flex: 1; min-height: 0; padding: 6px; }
+/* Highlight "it's my turn" (or any active panel) with the XP orange focus colour */
+.xp-panel--active { outline: 3px solid var(--xp-orange); outline-offset: 0; }
+
+/* Sunken white area inside a panel (hand, lists, empty slots) */
+.xp-well {
+  background: var(--xp-paper);
+  border: 2px solid var(--xp-ink);
+  box-shadow: inset 2px 2px 0 rgba(0, 0, 0, 0.12);
+  color: var(--xp-ink);
+}
+.xp-well--dashed { border-style: dashed; box-shadow: none; background: rgba(255, 255, 255, 0.55); }
+
+/* Player chip (scoreboard entries) */
+.xp-chip {
+  background: var(--xp-paper);
+  border: 2px solid var(--xp-ink);
+  box-shadow: 2px 2px 0 var(--xp-ink);
+  color: var(--xp-ink);
+  font-family: var(--xp-font);
+}
+.xp-chip--active { background: #fff7d6; outline: 3px solid var(--xp-orange); outline-offset: 0; }
+.xp-chip--offline { opacity: 0.6; }
+
+/* Small square index/number marker (market slot numbers, counts) */
+.xp-index {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 18px;
+  height: 18px;
+  padding: 0 4px;
+  background: var(--xp-blue);
+  border: 1.5px solid var(--xp-ink);
+  color: #fff;
+  font: bold 11px/1 var(--xp-font);
+}
+
+/* Floating toolbar buttons (sound, chat, history, theme) */
+.xp-fab {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  background: linear-gradient(180deg, #ffffff 0%, #f4f3ee 55%, #e3e0d4 100%);
+  border: 2px solid var(--xp-ink);
+  border-radius: 4px;
+  box-shadow: 3px 3px 0 var(--xp-ink);
+  color: var(--xp-ink);
+  font-size: 20px;
+  line-height: 1;
+  cursor: pointer;
+}
+.xp-fab:hover { background: linear-gradient(180deg, #ffffff 0%, #fdf3d8 55%, #f6d998 100%); }
+.xp-fab:active { transform: translate(3px, 3px); box-shadow: none; }
+.xp-fab--sm { width: 36px; height: 36px; font-size: 16px; }
+
+/* Modal backdrop: flat tint, no blur. z-index is set by the component. */
+.xp-overlay {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 16px;
+  background: rgba(0, 24, 80, 0.45);
+}
+
+/* Balloon / toast (XP notification-area tooltip) */
+.xp-balloon {
+  background: #ffffe1;
+  border: 2px solid var(--xp-ink);
+  box-shadow: 3px 3px 0 var(--xp-ink);
+  color: var(--xp-ink);
+  font: 13px/1.35 var(--xp-font);
+}
+.xp-balloon--ok { background: #e3f5d9; }
+.xp-balloon--err { background: #ffe3dc; }
+.xp-balloon--info { background: #e4eeff; }
+
+.xp-btn--danger { color: #fff; font-weight: bold; text-shadow: 1px 1px 0 #6b1606; background: linear-gradient(180deg, #f39a7d 0%, #e0532c 55%, #c4320f 100%); }
+.xp-btn--danger:hover:not(:disabled) { background: linear-gradient(180deg, #f6ae95 0%, #e86a45 55%, #d04016 100%); }
+.xp-btn--primary { color: #fff; font-weight: bold; text-shadow: 1px 1px 0 #0a1a6a; background: linear-gradient(180deg, #5aa6ff 0%, #1f6fe8 55%, #0d4fc4 100%); }
+.xp-btn--primary:hover:not(:disabled) { background: linear-gradient(180deg, #74b5ff 0%, #3480f0 55%, #1a5cd0 100%); }
+
+.xp-text-muted { color: #55554c; }
+
+/* XP-ish scrollbars inside the board */
+.xp-scroll { scrollbar-color: #c9c4b0 var(--xp-face); }
+.xp-scroll::-webkit-scrollbar { width: 14px; height: 14px; }
+.xp-scroll::-webkit-scrollbar-track { background: var(--xp-face); border-left: 1px solid var(--xp-ink); }
+.xp-scroll::-webkit-scrollbar-thumb { background: linear-gradient(90deg, #f4f3ee, #d8d4c4); border: 2px solid var(--xp-ink); }
