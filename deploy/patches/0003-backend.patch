+package ai
+
+import (
+	"math"
+
+	"golem_century/internal/ai/sim"
+)
+
+// intentTracker turns an AI move into at most one explainable message for a human ("took the
+// golem you were going for", …) and rate-limits repeats.
+type intentTracker struct {
+	last map[string]int16 // kind|target -> round it was last reported
+}
+
+// golemTargets returns, for seat h, the probability that each row golem is its current target
+// (softmax over discounted net value) and the turns it needs for each.
+func golemTargets(st *sim.State, h int, ev evaluator) (prob [sim.GolemRowSize]float64, turns [sim.GolemRowSize]int) {
+	p := &st.P[h]
+	rate := ev.engineRate(p)
+	val := [sim.GolemRowSize]float64{}
+	top := math.Inf(-1)
+	for j := 0; j < int(st.NRow); j++ {
+		g := &sim.Golems[st.Row[j]]
+		turns[j] = turnsToAfford(p.Res, g.Req, rate)
+		val[j] = float64(int(g.Points)+coinBonus(st, j)) * math.Pow(ev.w.Gamma, float64(turns[j]-1))
+		top = math.Max(top, val[j])
+	}
+	sum := 0.0
+	for j := 0; j < int(st.NRow); j++ {
+		prob[j] = math.Exp(0.6 * (val[j] - top))
+		sum += prob[j]
+	}
+	for j := 0; j < int(st.NRow); j++ {
+		prob[j] /= sum
+	}
+	return prob, turns
+}
+
+// detect inspects the chosen move against every human seat (seats outside the AI's team).
+func (it *intentTracker) detect(st *sim.State, a sim.Action, seat int, pv *perspective, p Profile, ev evaluator, teams []int) []Intent {
+	if it.last == nil {
+		it.last = map[string]int16{}
+	}
+	isHuman := func(i int) bool {
+		if i == seat {
+			return false
+		}
+		if seat < len(teams) && i < len(teams) {
+			return teams[i] != teams[seat]
+		}
+		return true
+	}
+	emit := func(kind IntentKind, target, cardID int, motive bool) []Intent {
+		key := string(kind) + "|" + string(rune('0'+target))
+		if r, ok := it.last[key]; ok && st.Round-r < 2 {
+			return nil
+		}
+		it.last[key] = st.Round
+		return []Intent{{Kind: kind, TargetID: target, CardID: cardID, Motive: motive}}
+	}
+
+	// was this move chosen against our own short-term interest? (motive / sacrifice)
+	ownBest, ownChosen := math.Inf(-1), 0.0
+	if p.Level >= Hard {
+		var buf [256]sim.Action
+		for _, b := range st.AppendLegal(buf[:0], sim.Search) {
+			if b.Kind == sim.AAcquire || b.Kind == sim.ADiscard {
+				continue // refills are random: skip the noisy ones for this comparison
+			}
+			c := *st
+			c.Apply(b, noDraw{})
+			v := ev.value(&c, seat)
+			ownBest = math.Max(ownBest, v)
+			if b == a {
+				ownChosen = v
+			}
+		}
+	}
+	againstSelf := p.Level >= Hard && !math.IsInf(ownBest, -1) && ownChosen < ownBest-0.75
+
+	switch a.Kind {
+	case sim.AClaim:
+		j := int(a.Card)
+		golemID := 101 + int(st.Row[j])
+		for h := 0; h < int(st.N); h++ {
+			if !isHuman(h) {
+				continue
+			}
+			prob, turns := golemTargets(st, h, ev)
+			if p.Utility == UtilityCoalition && againstSelf && turns[j] <= 3 {
+				return emit(IntentSacrifice, h+1, golemID, true)
+			}
+			if prob[j] >= 0.45 && turns[j] <= 2 {
+				return emit(IntentTookTargetGolem, h+1, golemID, againstSelf)
+			}
+			if coinBonus(st, j) > 0 && turns[j] <= 2 {
+				return emit(IntentBlockCoin, h+1, golemID, againstSelf)
+			}
+		}
+		if st.P[seat].Golems+2 == st.Goal {
+			return emit(IntentRushing, 0, golemID, false)
+		}
+	case sim.AAcquire:
+		m := st.Market[a.Card]
+		if cardPotential[m] < 8 {
+			return nil
+		}
+		for h := 0; h < int(st.N); h++ {
+			if !isHuman(h) {
+				continue
+			}
+			in := sim.Merchants[m].In
+			if sim.Merchants[m].Kind == sim.KTrade && st.P[h].Res.Covers(in, 1) {
+				return emit(IntentTookWantedCard, h+1, int(m)+1, againstSelf)
+			}
+		}
+	}
+	return nil
+}
+
+// noDraw is used where a refill would only add noise: it always takes the first unseen card.
+type noDraw struct{}
+
+func (noDraw) Merchant(int) int { return 0 }
+func (noDraw) Golem(int) int    { return 0 }
--- a/internal/ai/mcts.go
+++ b/internal/ai/mcts.go
@@ -0,0 +1,246 @@
+package ai
+
+import (
+	"math"
+	"math/rand/v2"
+
+	"golem_century/internal/ai/sim"
+)
+
+// node is one open-loop tree node: the move that leads to it from its parent plus statistics.
+// Nodes live in a per-tree slice and link by index (no pointers, no per-node allocation).
+type node struct {
+	act      sim.Action
+	key      uint64
+	prior    float32
+	visits   uint32
+	avail    uint32 // times this move was legal when its parent was visited
+	sum      [sim.MaxPlayers]float32
+	first    int32 // first child, -1 if none
+	next     int32 // next sibling, -1 if none
+	mover    int8  // seat that chooses among this node's children
+	expanded bool
+}
+
+// tree is one worker's open-loop MCTS: every iteration starts from the root position and samples
+// the unseen refills afresh (determinization per iteration), so hidden deck order never matters.
+type tree struct {
+	nodes  []node
+	cap    int
+	prof   Profile
+	pv     perspective
+	pl     policy
+	rng    *rand.Rand
+	drawer sim.RandDrawer
+	acts   []sim.Action
+	scores []float64
+	priors []float32
+	path   []int32
+	iters  int
+}
+
+// newTree creates a worker tree reusing the given node buffer (may be nil).
+func newTree(p Profile, pv perspective, pl policy, seed uint64, stream uint64, nodes []node) *tree {
+	rng := rand.New(rand.NewPCG(seed, stream))
+	capNodes := p.MaxNodes
+	if capNodes <= 0 {
+		capNodes = 200000
+	}
+	return &tree{
+		nodes:  nodes[:0],
+		cap:    capNodes,
+		prof:   p,
+		pv:     pv,
+		pl:     pl,
+		rng:    rng,
+		drawer: sim.RandDrawer{R: rng},
+		acts:   make([]sim.Action, 0, 256),
+		scores: make([]float64, 256),
+		priors: make([]float32, 256),
+		path:   make([]int32, 0, 64),
+	}
+}
+
+func (t *tree) reset(root *sim.State) {
+	t.nodes = t.nodes[:0]
+	t.nodes = append(t.nodes, node{first: -1, next: -1, mover: int8(root.Seat())})
+	t.iters = 0
+}
+
+// iterate runs one MCTS iteration from root.
+func (t *tree) iterate(root *sim.State) {
+	s := *root
+	t.path = append(t.path[:0], 0)
+	ni := int32(0)
+	for !s.Over {
+		acts := s.AppendLegal(t.acts[:0], sim.Search)
+		if !t.nodes[ni].expanded {
+			if len(t.nodes)+len(acts) > t.cap {
+				break // tree full: evaluate here
+			}
+			t.expand(ni, &s, acts)
+		} else {
+			t.addMissing(ni, &s, acts)
+		}
+		ci := t.selectChild(ni, acts)
+		if ci < 0 {
+			break
+		}
+		s.Apply(t.nodes[ci].act, t.drawer)
+		t.path = append(t.path, ci)
+		ni = ci
+		if t.nodes[ci].visits == 0 {
+			break // new leaf
+		}
+	}
+	var r [sim.MaxPlayers]float64
+	t.rollout(&s, &r)
+	for _, idx := range t.path {
+		n := &t.nodes[idx]
+		n.visits++
+		for i := 0; i < int(s.N); i++ {
+			n.sum[i] += float32(r[i])
+		}
+	}
+	t.iters++
+}
+
+// expand creates the children of node ni with priors from the full policy.
+func (t *tree) expand(ni int32, s *sim.State, acts []sim.Action) {
+	n := len(acts)
+	if cap(t.scores) < n {
+		t.scores = make([]float64, n)
+		t.priors = make([]float32, n)
+	}
+	scores, priors := t.scores[:n], t.priors[:n]
+	t.pl.fullScores(s, acts, t.drawer, scores)
+	if ni == 0 {
+		applyRootGuard(s, acts, scores)
+	}
+	softmaxPriors(scores, 1.0, priors)
+	mover := int8(s.Seat())
+	prev := int32(-1)
+	for i, a := range acts {
+		t.nodes = append(t.nodes, node{act: a, key: a.Key(), prior: priors[i], first: -1, next: -1})
+		idx := int32(len(t.nodes) - 1)
+		if prev < 0 {
+			t.nodes[ni].first = idx
+		} else {
+			t.nodes[prev].next = idx
+		}
+		prev = idx
+	}
+	t.nodes[ni].mover = mover
+	t.nodes[ni].expanded = true
+}
+
+// addMissing adds children for legal moves this node has not seen yet (a different refill made
+// them possible) with a small uniform prior.
+func (t *tree) addMissing(ni int32, s *sim.State, acts []sim.Action) {
+	last := int32(-1)
+	for c := t.nodes[ni].first; c >= 0; c = t.nodes[c].next {
+		last = c
+	}
+	for _, a := range acts {
+		k := a.Key()
+		found := false
+		for c := t.nodes[ni].first; c >= 0; c = t.nodes[c].next {
+			if t.nodes[c].key == k {
+				found = true
+				break
+			}
+		}
+		if found || len(t.nodes) >= t.cap {
+			continue
+		}
+		t.nodes = append(t.nodes, node{act: a, key: k, prior: 0.5 / float32(len(acts)), first: -1, next: -1})
+		idx := int32(len(t.nodes) - 1)
+		if last < 0 {
+			t.nodes[ni].first = idx
+		} else {
+			t.nodes[last].next = idx
+		}
+		last = idx
+	}
+}
+
+// selectChild picks the PUCT-best child among the moves legal in this iteration (availability
+// counts replace the parent visit count, as in ISMCTS).
+func (t *tree) selectChild(ni int32, acts []sim.Action) int32 {
+	parent := &t.nodes[ni]
+	mover := int(parent.mover)
+	parentQ := 0.5
+	if parent.visits > 0 {
+		parentQ = float64(parent.sum[mover]) / float64(parent.visits)
+	}
+	best, bestScore := int32(-1), math.Inf(-1)
+	for c := parent.first; c >= 0; c = t.nodes[c].next {
+		ch := &t.nodes[c]
+		legal := false
+		for i := range acts {
+			if acts[i].Key() == ch.key {
+				legal = true
+				break
+			}
+		}
+		if !legal {
+			continue
+		}
+		ch.avail++
+		q := parentQ - 0.1 // first-play urgency for unvisited moves
+		if ch.visits > 0 {
+			q = float64(ch.sum[mover]) / float64(ch.visits)
+		}
+		u := t.prof.CPuct * float64(ch.prior) * math.Sqrt(float64(ch.avail)) / (1 + float64(ch.visits))
+		if sc := q + u; sc > bestScore {
+			best, bestScore = c, sc
+		}
+	}
+	return best
+}
+
+// rollout plays ε-greedy fast moves for RolloutTurns rounds (to the end when near it and the
+// profile asks for it), then converts the evaluation into rewards.
+func (t *tree) rollout(s *sim.State, r *[sim.MaxPlayers]float64) {
+	plies := t.prof.RolloutTurns * int(s.N)
+	if t.prof.EndgameToTerminal && nearEnd(s) {
+		plies = 6 * int(s.N)
+	}
+	for i := 0; i < plies && !s.Over; i++ {
+		acts := s.AppendLegal(t.acts[:0], sim.Search)
+		s.Apply(rolloutMove(s, acts, t.prof.Epsilon, t.rng), t.drawer)
+	}
+	var v [sim.MaxPlayers]float64
+	t.pl.ev.values(s, &v)
+	winner := -1
+	if s.Over {
+		winner = int(s.Winner)
+	}
+	t.pv.rewards(&v, s.Over, winner, r)
+}
+
+// nearEnd reports whether the game is in its last round or someone is one golem from the goal.
+func nearEnd(s *sim.State) bool {
+	if s.LastRound {
+		return true
+	}
+	for i := 0; i < int(s.N); i++ {
+		if s.P[i].Golems+1 >= s.Goal {
+			return true
+		}
+	}
+	return false
+}
+
+// applyRootGuard removes moves no level should make at the root (scores to −∞ unless nothing
+// else is left): resting with nothing played.
+func applyRootGuard(s *sim.State, acts []sim.Action, scores []float64) {
+	if len(acts) < 2 || s.Cur().Played != 0 {
+		return
+	}
+	for i, a := range acts {
+		if a.Kind == sim.ARest {
+			scores[i] = math.Inf(-1)
+		}
+	}
+}
--- a/internal/ai/policy.go
+++ b/internal/ai/policy.go
@@ -0,0 +1,139 @@
+package ai
+
+import (
+	"math"
+	"math/rand/v2"
+
+	"golem_century/internal/ai/sim"
+)
+
+// policy scores moves for the player to move. Priors use the full evaluator (plus a denial term
+// for Hard/Very Hard); rollouts use cheap hand-written features (a "heavy playout").
+type policy struct {
+	ev           evaluator
+	denial       [sim.MaxPlayers]bool // seats whose losses count as our gain in priors
+	denialWeight float64
+}
+
+// fullScores scores every move by the mover's evaluation after it (best discard included) plus
+// the denial term. scores must have len(acts).
+func (pl *policy) fullScores(s *sim.State, acts []sim.Action, d sim.Drawer, scores []float64) {
+	mover := s.Seat()
+	var base [sim.MaxPlayers]float64
+	useDenial := false
+	for i := 0; i < int(s.N); i++ {
+		useDenial = useDenial || (pl.denial[i] && i != mover)
+	}
+	if useDenial {
+		pl.ev.values(s, &base)
+	}
+	var v [sim.MaxPlayers]float64
+	for i, a := range acts {
+		c := *s
+		c.Apply(a, d)
+		if c.P[mover].Pending > 0 && !c.Over {
+			pl.bestDiscard(&c, d)
+		}
+		pl.ev.values(&c, &v)
+		sc := v[mover]
+		if useDenial {
+			for q := 0; q < int(s.N); q++ {
+				if q != mover && pl.denial[q] {
+					sc += pl.denialWeight * (base[q] - v[q])
+				}
+			}
+		}
+		scores[i] = sc
+	}
+}
+
+// bestDiscard resolves a pending discard of the player to move by its own evaluation.
+func (pl *policy) bestDiscard(s *sim.State, d sim.Drawer) {
+	var buf [8]sim.Action
+	acts := s.AppendLegal(buf[:0], sim.Search)
+	if len(acts) == 0 {
+		return
+	}
+	mover := s.Seat()
+	best, bestV := acts[0], math.Inf(-1)
+	for _, a := range acts {
+		c := *s
+		c.Apply(a, d)
+		if v := pl.ev.value(&c, mover); v > bestV {
+			best, bestV = a, v
+		}
+	}
+	s.Apply(best, d)
+}
+
+// fastScore is the rollout policy: cheap features, no move application.
+func fastScore(s *sim.State, a sim.Action) float64 {
+	p := s.Cur()
+	switch a.Kind {
+	case sim.AClaim:
+		g := &sim.Golems[s.Row[a.Card]]
+		return 6 + float64(g.Points) + float64(coinBonus(s, int(a.Card)))
+	case sim.APlay:
+		d := &sim.Merchants[a.Card]
+		var after sim.Crystals
+		switch d.Kind {
+		case sim.KProduce:
+			after = p.Res
+			for c := 0; c < 4; c++ {
+				after[c] += d.Out[c]
+			}
+		case sim.KUpgrade:
+			after = a.Vec
+		case sim.KTrade:
+			after = p.Res
+			m := int8(a.Mult)
+			for c := 0; c < 4; c++ {
+				after[c] += (d.Out[c] - d.In[c]) * m
+			}
+		}
+		gain := float64(after.Level() - p.Res.Level())
+		if over := after.Total() - sim.MaxCrystals; over > 0 {
+			gain -= 1.5 * float64(over)
+		}
+		return gain
+	case sim.AAcquire:
+		m := s.Market[a.Card]
+		return 0.35*cardPotential[m] - 0.7*float64(a.Card) + 0.6*float64(s.MDep[a.Card].Level()) - 0.2*float64(a.Vec.Level())
+	case sim.ARest:
+		return 1.2*float64(popcount(p.Played)) - 2
+	case sim.ADiscard:
+		return -float64(a.Vec.Level())
+	}
+	return 0
+}
+
+// rolloutMove picks an ε-greedy move with fastScore.
+func rolloutMove(s *sim.State, acts []sim.Action, eps float64, rng *rand.Rand) sim.Action {
+	if rng.Float64() < eps {
+		return acts[rng.IntN(len(acts))]
+	}
+	best, bestV := 0, math.Inf(-1)
+	for i, a := range acts {
+		if v := fastScore(s, a); v > bestV {
+			best, bestV = i, v
+		}
+	}
+	return acts[best]
+}
+
+// softmaxPriors turns scores (points) into priors with temperature temp.
+func softmaxPriors(scores []float64, temp float64, out []float32) {
+	top := math.Inf(-1)
+	for _, v := range scores {
+		top = math.Max(top, v)
+	}
+	sum := 0.0
+	for i, v := range scores {
+		e := math.Exp((v - top) / temp)
+		out[i] = float32(e)
+		sum += e
+	}
+	for i := range out[:len(scores)] {
+		out[i] = float32(float64(out[i]) / sum)
+	}
+}
